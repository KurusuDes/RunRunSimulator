    m_Localized: "\xBFEmpezar de cero? Se borra tu partida: tus MoriMonchis, monedas
      y tienda."
    m_Metadata:
      m_Items: []
  - m_Id: 28969757563215876
    m_Localized: "S\xED, empezar de cero"
    m_Metadata:
      m_Items: []
