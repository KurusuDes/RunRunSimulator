    m_Metadata:
      m_Items: []
  - m_Id: 4172480282683
    m_Localized: "Inflige {0:F0} de da\xF1o plano al portador"
    m_Metadata:
      m_Items: []
  - m_Id: 4172480282684
    m_Localized: Escuda +{0:0.##} por turno al aliado con menos % de vida
    m_Metadata:
      m_Items: []
  - m_Id: 4172480282685
    m_Localized: "Cura {0:P0} del da\xF1o infligido al aliado con menos HP"
    m_Metadata:
      m_Items: []
  - m_Id: 4172480282686
    m_Localized: Comparte su elemento con un aliado al azar cada turno
    m_Metadata:
      m_Items: []
  - m_Id: 4172480282687
    m_Localized: '{0:P0} de probabilidad de cazar la backline enemiga'
