.brawl {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.brawl-side {
    position: absolute;
    top: 34px;
    width: 352px;
    padding: 6px 0;
}

.brawl-side--blue {
    left: 26px;
}

.brawl-side--red {
    right: 26px;
}

.brawl-side__shadow {
    display: none;
}

.brawl-side__tracery {
    position: absolute;
    top: -30px;
    bottom: -30px;
    width: 100px;
    background-image: url("Skin/Synty/Warrior/SPR_FantasyWarrior_Tracery_Vertical_08.png");
    -unity-slice-scale: 0.33;
}

.brawl-side--blue > .brawl-side__tracery {
    left: -5px;
}

.brawl-side--red > .brawl-side__tracery {
    right: -5px;
}

.brawl-side__title {
    display: none;
}

.brawl-cards {
    flex-direction: column;
}

.brawl-center {
    position: absolute;
    left: 0;
    right: 0;
    top: 22px;
    align-items: center;
}

.brawl-clock {
    width: 200px;
    height: 64px;
    justify-content: center;
    background-image: url("Skin/Synty/Warrior/SPR_HUD_FantasyWarrior_Container_01.png");
    -unity-background-image-tint-color: rgba(25, 41, 46, 0.86);
    -unity-slice-scale: 0.25;
}

.brawl-timer {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 40px;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    padding: 0;
    margin: 0;
}

.brawl-timer--sudden {
    color: var(--mm-coral);
}

.brawl-phase {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 19px;
    letter-spacing: 3px;
    color: rgb(250, 208, 136);
    margin-top: 4px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(10, 14, 16, 0.8);
}

.brawl-match {
    font-size: 14px;
    color: var(--mm-ink-soft);
    margin-top: 2px;
}

.brawl-card {
    flex-direction: row;
    align-items: center;
    height: 104px;
    margin: 7px 0;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.brawl-side--red .brawl-card {
    flex-direction: row-reverse;
}

.brawl-card--ko {
    opacity: 0.55;
}

.brawl-portrait {
    width: 90px;
    height: 100px;
    flex-shrink: 0;
}

.brawl-portrait__bg,
.brawl-portrait__grad,
.brawl-portrait__tracery,
.brawl-portrait__img,
.brawl-portrait__vignette,
.brawl-portrait__frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.brawl-portrait__bg {
    background-image: url("Skin/Synty/Warrior/SPR_HUD_FantasyWarrior_Gradient_Vertical_Solid_01.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.brawl-portrait__grad {
    background-image: url("Skin/Synty/Warrior/SPR_HUD_FantasyWarrior_Gradient_Vertical_Smooth_01.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.brawl-portrait__tracery {
    left: 6px;
    right: 6px;
    top: 4px;
    bottom: 4px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Tracery_Diamond_01.png");
    -unity-background-scale-mode: scale-and-crop;
}

.brawl-card--blue .brawl-portrait__bg {
    -unity-background-image-tint-color: rgb(0, 19, 53);
}

.brawl-card--blue .brawl-portrait__grad {
    -unity-background-image-tint-color: rgba(49, 99, 219, 0.9);
}

.brawl-card--blue .brawl-portrait__tracery {
    -unity-background-image-tint-color: rgba(77, 119, 224, 0.4);
}

.brawl-card--red .brawl-portrait__bg {
    -unity-background-image-tint-color: rgb(53, 6, 4);
}

.brawl-card--red .brawl-portrait__grad {
    -unity-background-image-tint-color: rgba(204, 52, 40, 0.9);
}

.brawl-card--red .brawl-portrait__tracery {
    -unity-background-image-tint-color: rgba(232, 102, 82, 0.4);
}

.brawl-portrait__img {
    left: 3px;
    right: 3px;
    top: 4px;
    bottom: 16px;
}

.brawl-portrait__damage {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 0;
    background-color: rgba(255, 6, 0, 0.32);
}

.brawl-portrait__vignette {
    background-image: url("Skin/Synty/Warrior/SPR_HUD_FantasyWarrior_Vignette_Box_Large_01.png");
    -unity-background-image-tint-color: rgba(1, 14, 37, 0.7);
    -unity-slice-scale: 0.12;
}

.brawl-card--red .brawl-portrait__vignette {
    -unity-background-image-tint-color: rgba(37, 6, 1, 0.7);
}

.brawl-portrait__frame {
    background-image: url("Skin/Synty/Warrior/SPR_FantasyWarrior_Frame_Box_Medium_01_Variant_01.png");
    -unity-slice-scale: 0.28;
}

.brawl-portrait__detail {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: -8px;
    height: 18px;
    background-image: url("Skin/Synty/Warrior/SPR_FantasyWarrior_Frame_Box_Medium_01_Detail_01.png");
    -unity-slice-scale: 0.2;
}

.brawl-portrait__hp,
.brawl-portrait__ko {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 7px;
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 20px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(5, 8, 16, 0.85);
    padding: 0;
    margin: 0;
}

.brawl-portrait__ko {
    display: none;
    font-size: 30px;
    letter-spacing: 3px;
    top: 0;
    bottom: 0;
    color: rgb(250, 208, 136);
}

.brawl-card--ko .brawl-portrait__ko {
    display: flex;
}

.brawl-card--ko .brawl-portrait__hp {
    display: none;
}

.brawl-card--ko .brawl-portrait__img {
    -unity-background-image-tint-color: rgb(110, 110, 110);
}

.brawl-card__info {
    flex-grow: 1;
    min-width: 0;
    margin: 0 0 0 8px;
    padding: 5px 12px 6px 12px;
    background-image: url("Skin/Synty/Warrior/SPR_HUD_FantasyWarrior_Box_Small_Parchment_01.png");
    -unity-background-image-tint-color: rgba(24, 21, 17, 0.78);
    -unity-slice-scale: 0.33;
}

.brawl-side--red .brawl-card__info {
    margin: 0 8px 0 0;
    align-items: flex-end;
}

.brawl-card__head {
    flex-direction: row;
    align-items: flex-end;
    max-width: 100%;
}

.brawl-side--red .brawl-card__head {
    flex-direction: row-reverse;
}

.brawl-card__name {
    flex-shrink: 1;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 21px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(10, 14, 16, 0.85);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 0;
    margin: 0;
}

.brawl-card__body {
    flex-shrink: 0;
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 15px;
    color: rgb(250, 208, 136);
    margin: 0 0 2px 7px;
    padding: 0;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(10, 14, 16, 0.8);
}

.brawl-side--red .brawl-card__body {
    margin: 0 7px 2px 0;
}

.brawl-hpbar {
    width: 220px;
    height: 26px;
    margin-top: 2px;
    justify-content: center;
}

.brawl-hpbar__track {
    position: absolute;
    left: 14px;
    right: 0;
    top: 7px;
    height: 12px;
    background-image: url("Skin/Synty/Warrior/SPR_FantasyWarrior_Bar_Horizontal_03_Mask.png");
    -unity-background-image-tint-color: rgba(25, 26, 29, 0.9);
    -unity-slice-scale: 0.12;
    overflow: hidden;
}

.brawl-hpbar__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background-image: url("Skin/Synty/Warrior/SPR_FantasyWarrior_Bar_Horizontal_05.png");
    -unity-slice-scale: 0.12;
    transition-property: width;
    transition-duration: 0.15s;
}

.brawl-card--blue .brawl-hpbar__fill {
    -unity-background-image-tint-color: rgb(84, 156, 255);
}

.brawl-card--red .brawl-hpbar__fill {
    -unity-background-image-tint-color: rgb(214, 56, 48);
}

.brawl-hpbar__shield {
    position: absolute;
    left: 0;
    top: 0;
    height: 40%;
    width: 0;
    background-color: rgba(220, 240, 255, 0.85);
}

.brawl-hpbar__heart {
    position: absolute;
    left: 0;
    top: 0;
    width: 26px;
    height: 26px;
    background-image: url("Skin/Synty/Warrior/SPR_FantasyWarrior_Heart_03.png");
    -unity-background-scale-mode: scale-to-fit;
}

.brawl-side--red .brawl-hpbar__track {
    left: 0;
    right: 14px;
    scale: -1 1;
}

.brawl-side--red .brawl-hpbar__heart {
    left: auto;
    right: 0;
}

.brawl-card__line {
    flex-direction: row;
    max-width: 220px;
    margin-top: 1px;
}

.brawl-side--red .brawl-card__line {
    flex-direction: row-reverse;
}

.brawl-card__posture,
.brawl-card__intent {
    font-size: 14px;
    padding: 0;
    margin: 0;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(10, 14, 16, 0.75);
    white-space: nowrap;
}

.brawl-card__posture {
    color: var(--mm-ink-soft);
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.brawl-card__intent {
    color: var(--hud-gold);
    margin: 0 0 0 8px;
    flex-shrink: 0;
}

.brawl-side--red .brawl-card__intent {
    margin: 0 8px 0 0;
}

.brawl-card__slots {
    flex-direction: row;
    margin-top: 4px;
}

.brawl-side--red .brawl-card__slots {
    flex-direction: row-reverse;
}

.brawl-slot {
    margin: 0 6px 0 0;
}

.brawl-side--red .brawl-slot {
    margin: 0 0 0 6px;
}

.brawl-slot--empty {
    opacity: 0.35;
}

.brawl-slot__box {
    width: 36px;
    height: 36px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Circle_Background_01.png");
    -unity-background-image-tint-color: rgba(1, 21, 37, 0.85);
}

.brawl-card--red .brawl-slot__box {
    -unity-background-image-tint-color: rgba(37, 8, 4, 0.85);
}

.brawl-slot__ring {
    position: absolute;
    left: -2px;
    top: -2px;
    right: -2px;
    bottom: -2px;
    background-image: url("Skin/Synty/SPR_FantasyMenus_Ring_Medium_01.png");
    -unity-background-image-tint-color: var(--mm-frame);
}

.brawl-slot--locked .brawl-slot__ring {
    -unity-background-image-tint-color: rgba(160, 120, 60, 0.7);
}

.brawl-slot__lock {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 18px;
    -unity-text-align: middle-center;
    color: var(--mm-ink-soft);
    padding: 0;
    margin: 0;
}

.brawl-slot__icon {
    position: absolute;
    left: 6px;
    top: 6px;
    right: 6px;
    bottom: 6px;
    transition-property: opacity;
    transition-duration: 0.15s;
}

.brawl-slot--charging .brawl-slot__icon {
    opacity: 0.5;
}

.brawl-slot__radial {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    transition-property: scale;
    transition-duration: 0.18s;
}

.brawl-slot__radial.radial--fired {
    scale: 1.25 1.25;
}

.brawl-slot__radial.radial--ready {
    scale: 1.06 1.06;
}

.brawl-feed {
    position: absolute;
    right: 26px;
    top: 420px;
    align-items: flex-end;
}

.brawl-feed__entry {
    flex-direction: row;
    align-items: center;
    height: 36px;
    margin-bottom: 5px;
    padding: 0 14px;
}

.brawl-feed__bg,
.brawl-feed__tracery {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.brawl-feed__bg {
    background-image: url("Skin/Synty/Warrior/SPR_HUD_FantasyWarrior_Box_Small_Parchment_01.png");
    -unity-background-image-tint-color: rgba(31, 27, 22, 0.82);
    -unity-slice-scale: 0.33;
}

.brawl-feed__tracery {
    left: 3px;
    right: 3px;
    top: 3px;
    bottom: 3px;
    background-image: url("Skin/Synty/Warrior/SPR_HUD_FantasyWarrior_Tracery_Box_02.png");
    -unity-background-image-tint-color: rgb(113, 91, 52);
    -unity-slice-scale: 0.17;
}

.brawl-feed__name {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 19px;
    padding: 0;
    margin: 0;
}

.brawl-feed__verb {
    font-size: 15px;
    color: var(--mm-ink-soft);
    margin: 0 6px;
    padding: 0;
}

.brawl-feed__icon {
    width: 22px;
    height: 22px;
    margin-left: 8px;
}

.brawl-banner-box {
    position: absolute;
    left: 0;
    right: 0;
    top: 26%;
    align-items: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.brawl-banner-box--show {
    opacity: 1;
}

.brawl-banner__glow {
    position: absolute;
    left: 18%;
    right: 18%;
    top: -40px;
    bottom: -40px;
    background-image: url("Skin/Synty/Warrior/SPR_FX_FantasyWarrior_Glow_01.png");
    -unity-background-image-tint-color: rgba(2, 2, 2, 0.55);
    -unity-background-scale-mode: stretch-to-fill;
}

.brawl-banner__header,
.brawl-banner__lines {
    display: none;
}

.brawl-banner-box--result .brawl-banner__header,
.brawl-banner-box--result .brawl-banner__lines {
    display: flex;
}

.brawl-banner-box--result .brawl-banner__glow {
    left: 6%;
    right: 6%;
    top: 84px;
    bottom: 74px;
    background-image: url("Skin/Synty/Warrior/SPR_HUD_FantasyWarrior_Gradient_Outwards_Smooth_01.png");
    -unity-background-image-tint-color: rgba(16, 20, 29, 0.8);
}

.brawl-banner__header {
    width: 435px;
    height: 65px;
    justify-content: center;
    margin-bottom: 8px;
    background-image: url("Skin/Synty/Warrior/SPR_HUD_FantasyWarrior_Gradient_Vertical_Solid_01.png");
    -unity-background-image-tint-color: rgb(46, 56, 60);
    -unity-background-scale-mode: stretch-to-fill;
}

.brawl-banner__ribbon {
    position: absolute;
    left: -36px;
    right: -36px;
    top: -2px;
    bottom: -2px;
    background-image: url("Skin/Synty/Warrior/SPR_FantasyWarrior_Banner_07.png");
    -unity-slice-scale: 0.16;
}

.brawl-banner__header-text {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 40px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    color: rgb(250, 208, 136);
    padding: 0;
    margin: 0;
}

.brawl-banner__lines {
    flex-direction: row;
    width: 900px;
    height: 24px;
}

.brawl-banner__line {
    flex-grow: 1;
    height: 24px;
    -unity-background-image-tint-color: rgb(255, 204, 95);
    -unity-slice-scale: 0.3;
}

.brawl-banner__line--l {
    background-image: url("Skin/Synty/Warrior/SPR_HUD_FantasyWarrior_Line_03_Right.png");
}

.brawl-banner__line--r {
    background-image: url("Skin/Synty/Warrior/SPR_HUD_FantasyWarrior_Line_03_Left.png");
}

.brawl-banner__lines--bottom {
    scale: 1 -1;
}

.brawl-banner {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 100px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(5, 8, 12, 0.7);
    padding: 0;
    margin: -6px 0;
    transition-property: scale;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-back;
}

.brawl-banner-box--result .brawl-banner {
    font-size: 78px;
}

.brawl-banner--pop {
    scale: 1.5 1.5;
    transition-duration: 0s;
}

.brawl-banner--ink {
    color: rgb(255, 255, 255);
}

.brawl-banner--blue {
    color: rgb(150, 200, 255);
}

.brawl-banner--red {
    color: rgb(255, 150, 140);
}

.brawl-banner--coral {
    color: var(--mm-coral);
}

.brawl-banner-sub {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 30px;
    -unity-text-align: middle-center;
    color: rgb(250, 208, 136);
    margin-top: 8px;
    padding: 6px 22px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(5, 8, 12, 0.7);
}

.brawl-banner-box--result .brawl-banner-sub {
    background-image: url("Skin/Synty/Warrior/SPR_HUD_FantasyWarrior_Box_Small_Parchment_01.png");
    -unity-background-image-tint-color: rgba(31, 43, 46, 0.9);
    -unity-slice-scale: 0.33;
    margin-top: 14px;
}

.brawl-controls {
    position: absolute;
    left: 16px;
    bottom: 14px;
    flex-direction: row;
    align-items: center;
    display: none;
}

.brawl-btn {
    min-height: 36px;
    margin: 0 6px 0 0;
    padding: 0 16px;
    font-size: 17px;
}

.brawl-btn--group {
    margin-right: 20px;
}

.brawl-btn--speed {
    min-width: 52px;
    padding: 0 8px;
}

.brawl-btn--on {
    -unity-background-image-tint-color: var(--mm-tab-fill-on);
    color: rgb(255, 255, 255);
}

.brawl-overheads {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.brawl-overheads__group {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.brawl-anchor {
    position: absolute;
    left: 0;
    top: 0;
    width: 240px;
    height: 0;
}

.brawl-plate {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.5s;
}

.brawl-plate--ko {
    opacity: 0;
}

.brawl-plate__name {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 17px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    margin: 0 0 1px 0;
    padding: 0;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(10, 14, 16, 0.9);
}

.brawl-plate__status {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    color: var(--mm-warn);
    white-space: nowrap;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(10, 14, 16, 0.9);
}

.brawl-obar {
    width: 96px;
    height: 11px;
    background-image: url("Skin/Synty/Warrior/SPR_FantasyWarrior_Bar_Horizontal_03_Mask.png");
    -unity-background-image-tint-color: rgba(25, 26, 29, 0.85);
    -unity-slice-scale: 0.1;
    overflow: hidden;
}

.brawl-obar__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background-image: url("Skin/Synty/Warrior/SPR_FantasyWarrior_Bar_Horizontal_05.png");
    -unity-slice-scale: 0.1;
}

.brawl-obar__shield {
    position: absolute;
    left: 0;
    top: 0;
    height: 40%;
    width: 0;
    background-color: rgba(220, 240, 255, 0.85);
}

.brawl-bubble-row {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 40px;
    align-items: center;
}

.brawl-bubble {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 34px;
    padding: 0 14px 0 8px;
    background-image: url("Skin/Synty/Warrior/SPR_HUD_FantasyWarrior_Box_Small_Parchment_01.png");
    -unity-background-image-tint-color: rgba(31, 27, 22, 0.88);
    -unity-slice-scale: 0.33;
    opacity: 0;
    transform-origin: 50% 100%;
    transition-property: opacity;
    transition-duration: 0.12s;
}

.brawl-bubble--show {
    opacity: 1;
}

.brawl-bubble__icon {
    width: 22px;
    height: 22px;
    margin-right: 6px;
}

.brawl-bubble__text {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 18px;
    color: rgb(255, 255, 255);
    white-space: nowrap;
    padding: 0;
    margin: 0;
}

.brawl-float {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 26px;
    letter-spacing: 1px;
    -unity-text-align: lower-center;
    white-space: nowrap;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(10, 8, 6, 0.9);
}

.brawl-float--hit {
    color: rgb(255, 255, 255);
}

.brawl-float--skill {
    font-size: 30px;
    color: rgb(255, 236, 200);
}

.brawl-float--big {
    font-size: 38px;
    color: rgb(253, 210, 90);
}

.brawl-float--heal {
    font-size: 26px;
    color: rgb(130, 230, 110);
}

.brawl-float--shield {
    font-size: 22px;
    color: rgb(170, 215, 255);
}
