.brawl {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.brawl-bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Box_Rounded_Medium_02.png");
    -unity-background-image-tint-color: var(--hud-pill);
    -unity-slice-scale: 0.2;
}

.brawl-frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Frame_Rounded_02.png");
    -unity-slice-scale: 0.25;
}

.brawl-top {
    position: absolute;
    top: 10px;
    left: 12px;
    right: 12px;
}

.brawl-bar {
    flex-direction: row;
    align-items: flex-start;
}

.brawl-team {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    padding: 8px 12px 10px 12px;
}

.brawl-team > .brawl-bg {
    opacity: 0.55;
}

.brawl-team--blue {
    margin-right: 8px;
}

.brawl-team--red {
    margin-left: 8px;
}

.brawl-team--blue > .brawl-frame {
    -unity-background-image-tint-color: rgba(150, 200, 255, 0.5);
}

.brawl-team--red > .brawl-frame {
    -unity-background-image-tint-color: rgba(255, 150, 140, 0.5);
}

.brawl-team__title {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 20px;
    letter-spacing: 3px;
    margin: 0 6px 4px 6px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
}

.brawl-team__title--blue {
    color: rgb(150, 200, 255);
}

.brawl-team__title--red {
    color: rgb(255, 150, 140);
    -unity-text-align: upper-right;
}

.brawl-cards {
    flex-direction: row;
}

.brawl-center {
    width: 330px;
    flex-shrink: 0;
    align-items: center;
    padding: 8px 14px 10px 14px;
}

.brawl-frame--gold {
    -unity-background-image-tint-color: var(--hud-gold);
}

.brawl-timer {
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 54px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.6);
}

.brawl-timer--sudden {
    color: var(--mm-coral);
}

.brawl-phase {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 20px;
    letter-spacing: 3px;
    color: var(--hud-gold);
    margin-top: -6px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
}

.brawl-match {
    font-size: 14px;
    color: var(--mm-ink-soft);
    margin-top: 2px;
}

.brawl-card {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    max-width: 260px;
    margin: 0 4px;
    padding: 8px 10px 8px 10px;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.brawl-card--blue > .brawl-frame {
    -unity-background-image-tint-color: rgba(150, 200, 255, 0.4);
}

.brawl-card--red > .brawl-frame {
    -unity-background-image-tint-color: rgba(255, 150, 140, 0.4);
}

.brawl-card--ko {
    opacity: 0.5;
}

.brawl-card--ko > .brawl-frame {
    -unity-background-image-tint-color: rgba(160, 150, 140, 0.35);
}

.brawl-card--ko .brawl-card__name {
    color: var(--mm-ink-soft);
}

.brawl-card__head {
    flex-direction: row;
    align-items: flex-end;
}

.brawl-card__name {
    flex-shrink: 1;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 19px;
    color: rgb(255, 255, 255);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.brawl-card__body {
    flex-shrink: 0;
    font-size: 14px;
    color: var(--mm-ink-soft);
    margin: 0 0 1px 6px;
}

.brawl-card__line {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 1px;
}

.brawl-card__posture {
    font-size: 14px;
    color: var(--mm-ink-soft);
}

.brawl-card__intent {
    font-size: 14px;
    color: var(--hud-gold);
}

.brawl-hp {
    height: 22px;
    margin-top: 4px;
    border-radius: 11px;
    background-color: rgba(17, 14, 12, 0.85);
    overflow: hidden;
    justify-content: center;
}

.brawl-hp__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
}

.brawl-hp__shield {
    position: absolute;
    left: 0;
    top: 0;
    height: 40%;
    width: 0;
    background-color: var(--mm-ally);
    opacity: 0.9;
}

.brawl-hp__label {
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 15px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
}

.brawl-hp__ko {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 20px;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    color: rgb(214, 150, 96);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
}

.brawl-card--ko .brawl-hp__label {
    display: none;
}

.brawl-card--ko .brawl-hp__ko {
    display: flex;
}

.brawl-card__slots {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 6px;
}

.brawl-slot {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    align-items: center;
}

.brawl-slot--empty {
    opacity: 0.35;
}

.brawl-slot__box {
    width: 46px;
    height: 46px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Circle_Background_01.png");
    -unity-background-image-tint-color: rgba(28, 24, 20, 0.9);
}

.brawl-slot__ring {
    position: absolute;
    left: -2px;
    top: -2px;
    right: -2px;
    bottom: -2px;
    background-image: url("Skin/Synty/SPR_FantasyMenus_Ring_Medium_01.png");
    -unity-background-image-tint-color: var(--hud-gold);
}

.brawl-slot--locked .brawl-slot__ring {
    -unity-background-image-tint-color: rgba(160, 120, 60, 0.7);
}

.brawl-slot__lock {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 22px;
    -unity-text-align: middle-center;
    color: var(--mm-ink-soft);
}

.brawl-slot__icon {
    position: absolute;
    left: 7px;
    top: 7px;
    right: 7px;
    bottom: 7px;
    transition-property: opacity;
    transition-duration: 0.15s;
}

.brawl-slot--charging .brawl-slot__icon {
    opacity: 0.55;
}

.brawl-slot__radial {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    transition-property: scale;
    transition-duration: 0.18s;
}

.brawl-slot__radial.radial--fired {
    scale: 1.2 1.2;
}

.brawl-slot__radial.radial--ready {
    scale: 1.06 1.06;
}

.brawl-slot__label {
    max-width: 100%;
    font-size: 14px;
    color: rgb(255, 255, 255);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
    margin-top: 2px;
    -unity-text-align: upper-center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.brawl-feed {
    align-self: flex-end;
    align-items: flex-end;
    margin: 8px 0 0 0;
}

.brawl-feed__entry {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
    padding: 3px 10px;
}

.brawl-feed__name {
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 16px;
}

.brawl-feed__verb {
    font-size: 15px;
    color: var(--mm-ink-soft);
    margin: 0 6px;
}

.brawl-feed__icon {
    width: 20px;
    height: 20px;
    margin-left: 6px;
}

.brawl-banner-box {
    position: absolute;
    left: 0;
    right: 0;
    top: 24%;
    align-items: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.brawl-banner-box--show {
    opacity: 1;
}

.brawl-banner {
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 120px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    text-shadow: 0 6px 8px rgba(0, 0, 0, 0.75);
    transition-property: scale;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-back;
}

.brawl-banner--pop {
    scale: 1.6 1.6;
    transition-duration: 0s;
}

.brawl-banner--ink {
    color: rgb(255, 255, 255);
}

.brawl-banner--blue {
    color: rgb(150, 200, 255);
}

.brawl-banner--red {
    color: rgb(255, 150, 140);
}

.brawl-banner--coral {
    color: var(--mm-coral);
}

.brawl-banner-sub {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 36px;
    -unity-text-align: middle-center;
    color: var(--hud-gold);
    margin-top: -6px;
    text-shadow: 0 3px 5px rgba(0, 0, 0, 0.75);
}

.brawl-controls {
    position: absolute;
    left: 16px;
    bottom: 14px;
    flex-direction: row;
    align-items: center;
    display: none;
}

.brawl-btn {
    min-height: 36px;
    margin: 0 6px 0 0;
    padding: 0 16px;
    font-size: 17px;
}

.brawl-btn--group {
    margin-right: 20px;
}

.brawl-btn--speed {
    min-width: 52px;
    padding: 0 8px;
}

.brawl-btn--on {
    -unity-background-image-tint-color: var(--mm-tab-fill-on);
    color: rgb(255, 255, 255);
}

.brawl-overheads {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.brawl-overheads__group {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.brawl-anchor {
    position: absolute;
    left: 0;
    top: 0;
    width: 240px;
    height: 0;
}

.brawl-plate {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.5s;
}

.brawl-plate--ko {
    opacity: 0;
}

.brawl-plate__name {
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 14px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    margin-bottom: 1px;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--mm-bg-deep);
}

.brawl-plate__status {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    color: var(--mm-warn);
    white-space: nowrap;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--mm-bg-deep);
}

.brawl-obar {
    width: 90px;
    height: 9px;
    border-radius: 5px;
    border-width: 1px;
    border-color: var(--mm-bg-deep);
    background-color: var(--mm-bg-deep);
    overflow: hidden;
}

.brawl-obar__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
}

.brawl-obar__shield {
    position: absolute;
    left: 0;
    top: 0;
    height: 45%;
    width: 0;
    background-color: var(--mm-ally);
    opacity: 0.9;
}

.brawl-bubble-row {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 36px;
    align-items: center;
}

.brawl-bubble {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 3px 10px 3px 6px;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Box_Rounded_Medium_02.png");
    -unity-background-image-tint-color: var(--hud-pill);
    -unity-slice-scale: 0.2;
    opacity: 0;
    transform-origin: 50% 100%;
    transition-property: opacity;
    transition-duration: 0.12s;
}

.brawl-bubble--show {
    opacity: 1;
}

.brawl-bubble__icon {
    width: 22px;
    height: 22px;
    margin-right: 5px;
}

.brawl-bubble__text {
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 16px;
    color: rgb(255, 255, 255);
    white-space: nowrap;
}

.brawl-float {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 22px;
    -unity-text-align: lower-center;
    white-space: nowrap;
    color: var(--mm-ink);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--mm-bg-deep);
}

.brawl-float--hit {
    color: var(--mm-ink);
}

.brawl-float--skill {
    font-size: 26px;
}

.brawl-float--big {
    font-size: 32px;
    color: var(--mm-gold);
}

.brawl-float--heal {
    font-size: 24px;
    color: var(--mm-good);
}

.brawl-float--shield {
    font-size: 20px;
    color: var(--mm-ally);
}
