.npc-tag {
    align-items: center;
    align-self: center;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Box_SpeechBubble_01.png");
    -unity-background-image-tint-color: var(--hud-bubble);
    -unity-slice-scale: 0.3;
    padding: 8px 18px 20px 18px;
}

.npc-tag__name {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 20px;
    color: rgb(120, 82, 40);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.npc-tag__thought {
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 21px;
    color: var(--hud-bubble-ink);
    -unity-text-align: middle-center;
    white-space: nowrap;
    margin-top: 2px;
}
