.store-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.store-window {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 62px;
    padding: 22px 48px 20px 48px;
    align-items: center;
}

.store-column {
    flex-grow: 1;
    width: 100%;
    max-width: 1400px;
}

.store-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 70px;
    flex-shrink: 0;
}

.store-title {
    -unity-text-align: middle-left;
    font-size: 52px;
}

.store-counter {
    flex-direction: row;
    align-items: center;
    min-width: 280px;
    height: 58px;
    padding: 0 22px 0 14px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Medium_Parchment02.png");
    -unity-background-image-tint-color: rgb(1, 14, 12);
    -unity-slice-scale: 0.3;
}

.store-counter__coin {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    flex-shrink: 0;
    background-image: url("Skin/Synty/ICON_FantasyWarrior_Inventory_Currency_01_Clean.png");
    -unity-background-image-tint-color: var(--mm-gold);
}

.store-balance {
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 26px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0;
    flex-grow: 1;
}

.store-bar {
    margin: 4px 0 10px 0;
}

.store-tabs {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    height: 70px;
    flex-shrink: 0;
}

.store-tab {
    height: 54px;
    padding: 0 16px;
    margin: 0 3px;
    font-size: 23px;
    letter-spacing: 1px;
    color: var(--mm-ink-soft);
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: 3px;
    border-bottom-color: rgba(0, 0, 0, 0);
    transition-property: color;
    transition-duration: 0.12s;
}

.store-tab:hover {
    color: rgb(255, 255, 255);
}

.store-tab--active {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    background-image: url("Skin/Synty/SPR_FantasyMenus_Gradient_Vertical_05.png");
    -unity-background-image-tint-color: rgba(40, 220, 160, 0.4);
    -unity-slice-scale: 0.4;
    border-bottom-color: var(--mm-gold);
}

.store-panel {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin-top: 4px;
}

.store-list {
    flex-grow: 1;
}

.store-row {
    flex-direction: row;
    align-items: center;
    min-height: 76px;
    padding: 8px 18px 8px 14px;
    margin-bottom: 8px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Medium_Parchment02.png");
    -unity-background-image-tint-color: var(--mm-row-fill);
    -unity-slice-scale: 0.22;
    border-left-width: 5px;
    border-left-color: rgba(0, 0, 0, 0);
}

.store-row--selected {
    -unity-background-image-tint-color: var(--mm-tab-fill);
    border-left-color: var(--mm-gold);
}

.store-row__name {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 56px;
    padding-left: 66px;
    font-size: 25px;
    color: var(--mm-ink);
    white-space: normal;
    -unity-text-align: middle-left;
    background-image: url("Skin/Synty/ICON_FantasyWarrior_Inventory_Items_01_Clean.png");
    -unity-background-image-tint-color: var(--mm-gold);
    background-size: 48px 48px;
    background-position-x: left;
    background-position-y: center;
    background-repeat: no-repeat;
}

.store-row--selected .store-row__name {
    color: rgb(255, 255, 255);
}

.store-row__price {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    max-width: 620px;
    min-height: 44px;
    margin-left: 14px;
    padding: 0 16px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Small_Parchment_02.png");
    -unity-background-image-tint-color: rgb(1, 14, 12);
    -unity-slice-scale: 0.45;
}

.store-price__now,
.store-price__now--sale {
    padding-left: 38px;
    font-size: 23px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    white-space: normal;
    -unity-text-align: middle-left;
    min-height: 34px;
    background-image: url("Skin/Synty/ICON_FantasyWarrior_Inventory_Currency_01_Clean.png");
    -unity-background-image-tint-color: var(--mm-gold);
    background-size: 30px 30px;
    background-position-x: left;
    background-position-y: center;
    background-repeat: no-repeat;
}

.store-price__now--sale {
    color: var(--mm-good);
}

.store-price__now--minerita {
    color: var(--mm-teal);
    background-image: url("Skin/Synty/ICON_FantasyWarrior_Inventory_Minerals_01_Clean.png");
    -unity-background-image-tint-color: var(--mm-teal);
}

.store-price__was {
    font-size: 18px;
    color: var(--mm-ink-soft);
    margin-right: 10px;
    opacity: 0.75;
}

.store-row__stock {
    min-width: 84px;
    min-height: 38px;
    margin-left: 14px;
    padding: 2px 12px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Small_Parchment_02.png");
    -unity-background-image-tint-color: rgb(1, 14, 12);
    -unity-slice-scale: 0.45;
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--mm-ink-soft);
    -unity-text-align: middle-center;
}

.store-row__stock--low {
    color: var(--mm-warn);
}

.store-row__stock--empty {
    color: var(--mm-crit);
}

.store-row__buy {
    min-width: 150px;
    height: 54px;
    margin: 0 0 0 16px;
    padding: 0 22px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Skin/Synty/SPR_FantasyMenus_Box_Small_Parchment_03.png");
    -unity-background-image-tint-color: var(--mm-gold);
    -unity-slice-scale: 0.35;
    font-size: 23px;
    -unity-font-style: bold;
    color: var(--mm-ink-dark);
    -unity-text-align: middle-center;
    transition-property: scale, -unity-background-image-tint-color;
    transition-duration: 0.12s;
}

.store-row__buy:hover {
    -unity-background-image-tint-color: rgb(250, 214, 150);
    background-color: rgba(0, 0, 0, 0);
    scale: 1.04 1.04;
}

.store-row__buy:active {
    scale: 0.97 0.97;
    background-color: rgba(0, 0, 0, 0);
}

.store-row__buy:focus {
    background-color: rgba(0, 0, 0, 0);
}

.store-row__buy:disabled {
    opacity: 0.45;
    scale: 1 1;
}

.store-row__buy--disabled {
    -unity-background-image-tint-color: var(--mm-frame-soft);
    background-color: rgba(0, 0, 0, 0);
}

.store-empty {
    position: absolute;
    left: 54px;
    right: 54px;
    top: 38%;
    font-size: 28px;
    color: var(--mm-ink-soft);
    -unity-text-align: middle-center;
    white-space: normal;
}

.store-notify {
    position: absolute;
    left: 140px;
    right: 140px;
    bottom: 26px;
    min-height: 54px;
    padding: 6px 24px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Medium_Parchment02.png");
    -unity-background-image-tint-color: rgb(120, 28, 20);
    -unity-slice-scale: 0.3;
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 25px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    white-space: normal;
}
