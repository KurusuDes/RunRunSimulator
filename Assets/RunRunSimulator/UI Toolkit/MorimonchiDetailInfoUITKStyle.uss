.detail-window {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 62px;
    padding: 0 48px 18px 48px;
}

.detail-tabs {
    flex-grow: 1;
}

.detail-tabs .unity-tab-view__content-container,
.detail-tabs .unity-tab__content-container {
    flex-grow: 1;
}

.info-body {
    flex-direction: row;
    flex-grow: 1;
    align-items: stretch;
}

.info-left {
    width: 440px;
    flex-shrink: 0;
}

.info-center {
    flex-grow: 1;
    flex-shrink: 1;
}

.info-right-panel {
    width: 600px;
    flex-shrink: 0;
}

.portrait {
    width: 600px;
    height: 600px;
    -unity-background-scale-mode: scale-to-fit;
}

.detail-stage {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.detail-stage__core {
    flex-grow: 1;
    align-self: stretch;
    align-items: center;
    justify-content: center;
}

.detail-stage__beam {
    position: absolute;
    width: 520px;
    height: 760px;
    background-image: url("Skin/Synty/SPR_FantasyMenus_FX_Glow_01.png");
    -unity-background-image-tint-color: rgba(110, 230, 185, 0.22);
}

.detail-stage__floor {
    position: absolute;
    bottom: 24%;
    width: 440px;
    height: 104px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Circle_Background_01.png");
    -unity-background-image-tint-color: rgba(0, 10, 8, 0.55);
}

.detail-stage__floor-ring {
    position: absolute;
    left: -10px;
    right: -10px;
    top: -4px;
    bottom: -4px;
    border-radius: 50%;
    border-width: 3px;
    border-color: rgba(227, 187, 113, 0.65);
}

.detail-slots {
    width: 140px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
}

.detail-slot {
    align-items: center;
    margin: 12px 0;
}

.detail-slot__box {
    width: 86px;
    height: 86px;
}

.detail-slot__icon {
    width: 58px;
    height: 58px;
    -unity-background-scale-mode: scale-to-fit;
}

.detail-slot__icon--body {
    background-image: url("Skin/Synty/ICON_FantasyScreens_Character_Body_01_Clean.png");
}

.detail-slot__icon--face {
    background-image: url("Skin/Synty/ICON_FantasyScreens_Character_Head_01_Clean.png");
}

.detail-slot__icon--horn,
.detail-slot__icon--back,
.detail-slot__icon--wing {
    background-image: url("Skin/Synty/ICON_FantasyScreens_Character_Body_01_Clean.png");
    opacity: 0.6;
}

.detail-slot__label {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 19px;
    color: var(--mm-section);
    margin-top: 6px;
    -unity-text-align: middle-center;
}

.detail-slot__name {
    font-size: 17px;
    color: var(--mm-ink);
    max-width: 136px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.detail-stats {
    flex-direction: row;
    justify-content: space-between;
    margin: 4px 0 6px 0;
}

.detail-stat {
    width: 25%;
    align-items: center;
}

.detail-stat__box {
    width: 64px;
    height: 64px;
}

.detail-stat__icon {
    width: 40px;
    height: 40px;
}

.detail-stat__icon--state {
    background-image: url("Skin/Synty/ICON_FantasyWarrior_Status_Up_01_Clean.png");
    -unity-background-image-tint-color: rgb(120, 220, 160);
}

.detail-stat__icon--born {
    background-image: url("Skin/Synty/ICON_FantasyWarrior_Status_Time_01_Clean.png");
    -unity-background-image-tint-color: rgb(250, 208, 136);
}

.detail-stat__icon--breeds {
    background-image: url("Skin/Synty/ICON_FantasyWarrior_Status_Health_02_Clean.png");
    -unity-background-image-tint-color: rgb(240, 140, 200);
}

.detail-stat__icon--battles {
    background-image: url("Skin/Synty/ICON_FantasyWarrior_Status_Attack_01_Clean.png");
    -unity-background-image-tint-color: rgb(232, 112, 80);
}

.detail-stat__value {
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 21px;
    color: rgb(255, 255, 255);
    margin-top: 4px;
    -unity-text-align: middle-center;
}

.detail-stat__label {
    font-size: 16px;
    color: var(--mm-ink-soft);
    -unity-text-align: middle-center;
}

.detail-powers-title {
    margin-top: 12px;
    margin-bottom: 10px;
}

.detail-personality__name {
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 25px;
    color: rgb(255, 255, 255);
}

.detail-personality__desc {
    font-size: 20px;
    color: var(--mm-ink-soft);
    white-space: normal;
    margin-bottom: 4px;
}

.page-panel {
    flex-grow: 1;
    margin: 0 160px;
}

.detail-title {
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 26px 40px;
    height: 52px;
}

.care-title {
    margin-bottom: 18px;
}

.needs {
    flex-direction: column;
}

.detail-need {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

.detail-need__body {
    flex-grow: 1;
    margin-left: 12px;
}

.detail-need__head {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
}

.detail-need__value {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 20px;
    color: var(--mm-ink-soft);
    margin-bottom: 4px;
}

.detail-need__label {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 22px;
    color: var(--mm-ink);
    margin-bottom: 4px;
}

.detail-need__bar-track {
    height: 22px;
    background-image: url("Skin/Synty/SPR_FantasyMenus_Box_Small_Parchment_01.png");
    -unity-background-image-tint-color: rgb(1, 14, 12);
    -unity-slice-scale: 0.15;
    padding: 3px;
}

.detail-need__bar-fill {
    height: 100%;
    border-radius: 5px;
}

.exp-bar--good { background-color: var(--mm-good); }
.exp-bar--warn { background-color: var(--mm-warn); }
.exp-bar--crit { background-color: var(--mm-crit); }

.detail-need--blocked .detail-need__label {
    color: var(--mm-crit);
}

.explore-status {
    margin-top: 10px;
    padding: 8px 12px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Small_Parchment_02.png");
    -unity-slice-scale: 0.45;
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 22px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
}

.explore-status--ready { -unity-background-image-tint-color: rgb(40, 120, 60); }
.explore-status--blocked { -unity-background-image-tint-color: rgb(150, 40, 30); }

.combat-role {
    margin-top: 14px;
    align-items: flex-start;
}

.combat-role__title {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 20px;
    color: var(--mm-section);
    margin-bottom: 6px;
}

.combat-role__pill {
    align-items: flex-start;
}

.combat-role__pill .mm-rolepill__seg {
    font-size: 18px;
    padding: 4px 14px;
}

.combat-role__pill .mm-rolepill__seg--minor {
    font-size: 15px;
    padding: 4px 10px;
}

.info-right {
    flex-grow: 1;
}

.info-block {
    font-size: 21px;
    color: var(--mm-ink);
    white-space: normal;
    margin-bottom: 4px;
}

.parts {
    flex-direction: column;
}

.part-row {
    flex-direction: row;
    align-items: center;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Medium_Parchment02.png");
    -unity-background-image-tint-color: var(--mm-row-fill);
    -unity-slice-scale: 0.22;
    padding: 8px 12px;
    margin-bottom: 6px;
}

.part-swatch {
    width: 44px;
    height: 44px;
    margin-right: 12px;
    flex-shrink: 0;
    border-radius: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.part-icon {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.part-icon--horn { -unity-background-image-tint-color: var(--mm-gold); }
.part-icon--back { -unity-background-image-tint-color: var(--mm-teal); }
.part-icon--wing { -unity-background-image-tint-color: var(--mm-plum); }

.part-swatch--ring {
    border-width: 2px;
    border-radius: 8px;
}

.part-text {
    flex-grow: 1;
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 22px;
    color: var(--mm-teal);
    white-space: normal;
}

.part-body {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
}

.part-body > .part-text {
    flex-grow: 0;
}

.part-power {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 2px;
}

.part-power__title {
    flex-shrink: 0;
    margin-right: 8px;
    font-size: 19px;
    -unity-font-style: bold;
    color: var(--mm-ink);
}

.part-power__desc {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 18px;
    color: var(--mm-ink-soft);
    white-space: normal;
}

.part-power--locked .part-power__title {
    color: var(--mm-ink-soft);
    -unity-font-style: italic;
}

.part-power--locked .part-power__desc {
    -unity-font-style: italic;
}

.part-evo {
    margin-top: 6px;
    align-items: flex-start;
}

.part-evo__head {
    flex-direction: row;
    align-items: center;
}

.part-evo__pips {
    flex-direction: row;
    align-items: center;
    margin-right: 6px;
}

.part-evo__pip {
    width: 14px;
    height: 14px;
    margin-right: 4px;
    rotate: 45deg;
    border-width: 2px;
    border-color: var(--mm-frame-soft);
    background-color: rgba(0, 0, 0, 0);
}

.part-evo__pip--on {
    border-color: var(--mm-gold);
    background-color: var(--mm-gold);
}

.part-evo__level {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--mm-ink-soft);
}

.part-evo__done {
    font-size: 18px;
    color: var(--mm-good);
    white-space: normal;
}

.part-evo__next {
    font-size: 18px;
    color: var(--mm-ink);
    white-space: normal;
}

.part-evo__max {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--mm-gold);
}

.part-evo--candidate .part-evo__next {
    color: var(--mm-plum);
    -unity-font-style: bold;
}

.part-evo--fresh {
    padding: 4px;
    border-radius: 6px;
    background-color: rgba(227, 187, 113, 0.15);
}

.evo-action {
    flex-direction: column;
    padding: 12px 14px;
    margin-bottom: 10px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Medium_Parchment02.png");
    -unity-background-image-tint-color: rgba(70, 52, 12, 0.85);
    -unity-slice-scale: 0.22;
}

.evo-action__button {
    height: 48px;
    margin: 6px 0 0 0;
    padding: 0 18px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Skin/Synty/SPR_FantasyMenus_Box_Small_Parchment_03.png");
    -unity-background-image-tint-color: var(--mm-gold);
    -unity-slice-scale: 0.35;
    font-size: 21px;
    -unity-font-style: bold;
    color: var(--mm-ink-dark);
}

.evo-action__button:hover {
    -unity-background-image-tint-color: rgb(250, 214, 150);
    background-color: rgba(0, 0, 0, 0);
}

.evo-action__button:disabled {
    opacity: 0.45;
}

.evo-action__xp {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 21px;
    color: var(--mm-section);
}

.evo-action__hint {
    margin-top: 4px;
    font-size: 18px;
    color: var(--mm-ink-soft);
    white-space: normal;
}

.evo-action__result {
    margin-bottom: 4px;
    font-size: 21px;
    -unity-font-style: bold;
    color: var(--mm-gold);
    white-space: normal;
}

.evo-action__max {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--mm-gold);
    white-space: normal;
}

.lineage-body { flex-grow: 1; }
.lineage-tree { align-items: center; padding: 12px; }

.inherit-list { padding: 0 12px; margin-bottom: 12px; }
.inherit-line { flex-direction: row; flex-wrap: wrap; align-items: flex-start; margin-bottom: 6px; }
.inherit-line__part {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 22px;
    color: var(--mm-teal);
}
.inherit-line__text {
    font-size: 21px;
    color: var(--mm-ink);
    white-space: normal;
    flex-shrink: 1;
}

.tree-block { align-items: center; }
.tree-parents { flex-direction: row; justify-content: center; align-items: flex-end; }
.tree-children { flex-direction: row; justify-content: center; align-items: flex-start; }
.tree-branch { align-items: center; margin-left: 12px; margin-right: 12px; }
.tree-partner { align-items: center; margin-left: 16px; margin-right: 16px; }

.tree-chip {
    width: 124px;
    align-items: center;
    padding: 10px 6px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Medium_Parchment02.png");
    -unity-background-image-tint-color: var(--mm-row-fill);
    -unity-slice-scale: 0.2;
    border-width: 2px;
    border-radius: 10px;
    border-color: rgba(227, 187, 113, 0.35);
}
.tree-chip--self { border-color: var(--mm-gold); }
.tree-chip--partner { border-color: var(--mm-plum); }
.tree-chip--unknown { opacity: 0.7; }
.tree-swatch { width: 72px; height: 72px; margin-bottom: 6px; -unity-background-scale-mode: scale-to-fit; }
.tree-name {
    width: 100%;
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--mm-ink);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.tree-role { font-size: 15px; color: var(--mm-section); -unity-text-align: middle-center; }
.tree-dead .tree-name { color: var(--mm-crit); }

.tree-connector-v { width: 2px; height: 18px; background-color: rgba(227, 187, 113, 0.6); }
.tree-connector-h { height: 2px; background-color: rgba(227, 187, 113, 0.6); }

.placeholder {
    flex-grow: 1;
    font-size: 24px;
    color: var(--mm-ink-soft);
    -unity-text-align: middle-center;
    white-space: normal;
}

.relations-body { flex-grow: 1; }

.relations-list {
    flex-direction: row;
    flex-wrap: wrap;
}

.relation-chip {
    width: 124px;
    align-items: center;
    padding: 10px 6px;
    margin: 5px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Medium_Parchment02.png");
    -unity-background-image-tint-color: var(--mm-row-fill);
    -unity-slice-scale: 0.2;
    border-width: 2px;
    border-radius: 10px;
    border-color: rgba(227, 187, 113, 0.35);
}

.relation-chip--good { border-color: var(--mm-good); }
.relation-chip--bad  { border-color: var(--mm-crit); }

.relation-swatch {
    width: 72px;
    height: 72px;
    margin-bottom: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.relation-name {
    width: 100%;
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--mm-ink);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.relation-glyph {
    font-size: 18px;
    -unity-text-align: middle-center;
}

.relation-glyph--good { color: var(--mm-good); }
.relation-glyph--bad  { color: var(--mm-crit); }
