<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Theme.uss" />
    <Style src="BrawlHudStyle.uss" />
    <ui:VisualElement name="brawl-root" class="mm-theme mm-theme--night mm-skin mm-hud brawl" picking-mode="Ignore">
        <ui:VisualElement name="brawl-team-blue" class="brawl-side brawl-side--blue" picking-mode="Ignore">
            <ui:VisualElement class="brawl-side__shadow" picking-mode="Ignore" />
            <ui:VisualElement class="brawl-side__tracery" picking-mode="Ignore" />
            <ui:Label name="brawl-title-blue" text="" class="brawl-side__title" picking-mode="Ignore" />
            <ui:VisualElement name="brawl-cards-blue" class="brawl-cards" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="brawl-team-red" class="brawl-side brawl-side--red" picking-mode="Ignore">
            <ui:VisualElement class="brawl-side__shadow" picking-mode="Ignore" />
            <ui:VisualElement class="brawl-side__tracery" picking-mode="Ignore" />
            <ui:Label name="brawl-title-red" text="" class="brawl-side__title" picking-mode="Ignore" />
            <ui:VisualElement name="brawl-cards-red" class="brawl-cards" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="brawl-center" class="brawl-center" picking-mode="Ignore">
            <ui:VisualElement class="brawl-clock" picking-mode="Ignore">
                <ui:Label name="brawl-timer" text="1:30" class="brawl-timer" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="brawl-phase" text="" class="brawl-phase" picking-mode="Ignore" />
            <ui:Label name="brawl-match" text="" class="brawl-match" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="brawl-feed" class="brawl-feed" picking-mode="Ignore" />
        <ui:VisualElement name="brawl-banner-box" class="brawl-banner-box" picking-mode="Ignore">
            <ui:VisualElement class="brawl-banner__glow" picking-mode="Ignore" />
            <ui:VisualElement class="brawl-banner__lines brawl-banner__lines--top" picking-mode="Ignore">
                <ui:VisualElement class="brawl-banner__line brawl-banner__line--l" picking-mode="Ignore" />
                <ui:VisualElement class="brawl-banner__line brawl-banner__line--r" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="brawl-banner__header" picking-mode="Ignore">
                <ui:VisualElement class="brawl-banner__ribbon" picking-mode="Ignore" />
                <ui:Label name="brawl-banner-header" text="" class="brawl-banner__header-text" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="brawl-banner" text="" class="brawl-banner" picking-mode="Ignore" />
            <ui:VisualElement class="brawl-banner__lines brawl-banner__lines--bottom" picking-mode="Ignore">
                <ui:VisualElement class="brawl-banner__line brawl-banner__line--l" picking-mode="Ignore" />
                <ui:VisualElement class="brawl-banner__line brawl-banner__line--r" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="brawl-banner-sub" text="" class="brawl-banner-sub" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="brawl-controls" class="brawl-controls" picking-mode="Ignore">
            <ui:Button name="brawl-new" text="" focusable="false" class="mm-button brawl-btn" />
            <ui:Button name="brawl-rematch" text="" focusable="false" class="mm-button brawl-btn brawl-btn--group" />
            <ui:Button name="brawl-speed-1" text="1×" focusable="false" class="mm-button mm-button--alt brawl-btn brawl-btn--speed" />
            <ui:Button name="brawl-speed-2" text="2×" focusable="false" class="mm-button mm-button--alt brawl-btn brawl-btn--speed" />
            <ui:Button name="brawl-speed-4" text="4×" focusable="false" class="mm-button mm-button--alt brawl-btn brawl-btn--speed" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
