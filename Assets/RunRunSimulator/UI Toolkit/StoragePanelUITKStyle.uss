.storage-root {
    align-items: center;
    justify-content: center;
    padding-bottom: 62px;
}

.storage-panel {
    width: 820px;
    height: 72%;
}

.storage-title {
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 28px 44px;
    height: 54px;
}

.storage-list {
    flex-grow: 1;
}

.storage-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: 68px;
    padding: 8px 18px 8px 16px;
    margin: 0 4px 8px 0;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Medium_Parchment02.png");
    -unity-background-image-tint-color: var(--mm-row-fill);
    -unity-slice-scale: 0.22;
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.12s;
}

.storage-row:hover {
    -unity-background-image-tint-color: rgba(0, 58, 48, 0.95);
}

.storage-row--selected {
    -unity-background-image-tint-color: rgba(0, 96, 76, 0.95);
}

.storage-row__name {
    flex-grow: 1;
    flex-shrink: 1;
    padding-left: 60px;
    min-height: 48px;
    -unity-text-align: middle-left;
    background-image: url("Skin/Synty/ICON_FantasyScreens_Inventory_Backpack_01_Clean.png");
    background-position: left center;
    background-repeat: no-repeat;
    background-size: 44px 44px;
    -unity-background-image-tint-color: var(--mm-gold);
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 24px;
    color: var(--mm-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.storage-row--selected .storage-row__name {
    color: rgb(255, 255, 255);
}

.storage-row__eject {
    flex-shrink: 0;
    min-width: 128px;
    min-height: 46px;
    margin: 0 0 0 16px;
    padding: 0 22px;
    background-image: url("Skin/Synty/SPR_FantasyMenus_Box_Small_Parchment_03.png");
    -unity-background-image-tint-color: var(--mm-gold);
    -unity-slice-scale: 0.35;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    font-size: 21px;
    -unity-font-style: bold;
    color: var(--mm-ink-dark);
    -unity-text-align: middle-center;
}

.storage-row__eject:hover {
    -unity-background-image-tint-color: rgb(250, 214, 150);
    background-color: rgba(0, 0, 0, 0);
}

.storage-row__eject:active {
    scale: 0.97 0.97;
}

.storage-empty {
    position: absolute;
    left: 54px;
    right: 54px;
    top: 170px;
    padding: 96px 20px 0 20px;
    background-image: url("Skin/Synty/ICON_FantasyScreens_Inventory_Backpack_01_Clean.png");
    background-position: center top;
    background-repeat: no-repeat;
    background-size: 84px 84px;
    -unity-background-image-tint-color: rgba(170, 196, 186, 0.55);
    font-size: 24px;
    color: var(--mm-ink-soft);
    -unity-text-align: upper-center;
    white-space: normal;
}
