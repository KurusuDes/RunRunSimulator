.storage-root {
    align-items: center;
    justify-content: center;
    padding-bottom: 62px;
}

.storage-panel {
    width: 1100px;
    height: 760px;
}

.storage-title {
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 28px 44px;
    height: 54px;
}

.storage-subtitle {
    height: 30px;
}

.storage-grid {
    flex-grow: 1;
    flex-basis: 0;
    margin-bottom: 6px;
}

.storage-grid .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    width: 832px;
    align-self: center;
    padding: 8px 0 0 0;
}

.storage-grid .unity-scroll-view__vertical-scroller {
    width: 12px;
}

.storage-hotbar {
    flex-direction: row;
    justify-content: flex-start;
    width: 832px;
    margin-right: 12px;
    align-self: center;
    flex-shrink: 0;
    padding: 8px 0 6px 0;
}

.storage-slot {
    width: 96px;
    height: 96px;
    margin: 0 4px 10px 4px;
}

.storage-slot__box {
    width: 96px;
    height: 96px;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Box_Rounded_Medium_01.png");
    -unity-background-image-tint-color: rgb(99, 75, 49);
    -unity-slice-scale: 0.2;
    transition-property: scale, -unity-background-image-tint-color;
    transition-duration: 0.12s;
}

.storage-slot__runes {
    position: absolute;
    left: 6px;
    top: 6px;
    width: 84px;
    height: 84px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Tracery_Diamond_01.png");
    -unity-background-image-tint-color: rgba(36, 32, 26, 0.6);
}

.storage-slot__icon {
    position: absolute;
    left: 8px;
    top: 8px;
    width: 80px;
    height: 80px;
    -unity-background-scale-mode: scale-to-fit;
}

.storage-slot__name {
    position: absolute;
    left: 0;
    top: 0;
    width: 96px;
    height: 96px;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    -unity-text-align: middle-center;
    white-space: normal;
    font-size: 15px;
    color: rgb(255, 255, 255);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
}

.storage-slot__count {
    position: absolute;
    right: 8px;
    bottom: 4px;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    -unity-text-align: lower-right;
    font-size: 20px;
    color: rgb(255, 255, 255);
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.8);
}

.storage-slot__frame {
    position: absolute;
    left: -7px;
    top: -7px;
    right: -7px;
    bottom: -7px;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Frame_Rounded_02.png");
    -unity-background-image-tint-color: rgb(253, 230, 124);
    -unity-slice-scale: 0.25;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.12s;
}

.storage-slot--filled:hover .storage-slot__box {
    -unity-background-image-tint-color: rgb(115, 88, 58);
}

.storage-slot--selected .storage-slot__box {
    -unity-background-image-tint-color: rgb(122, 92, 60);
    scale: 1.06 1.06;
}

.storage-slot--selected .storage-slot__frame {
    opacity: 1;
}
