<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Theme.uss" />
    <Style src="BreedingPanelUITKStyle.uss" />
    <ui:VisualElement name="backdrop" class="mm-theme mm-skin mm-screen breed-backdrop">
        <ui:VisualElement class="mm-screen__vignette" picking-mode="Ignore" />

        <ui:VisualElement name="window" class="breed-window">
            <ui:TabView name="tabs" class="breed-tabs mm-tabs">

                <ui:Tab label="Criar" name="tab-criar">
                    <ui:VisualElement class="criar-content">

                        <ui:VisualElement class="breed-picker mm-panel mm-panel--compact">
                            <ui:VisualElement class="mm-layer mm-panel__lip" picking-mode="Ignore" />
                            <ui:VisualElement class="mm-layer mm-panel__frame" picking-mode="Ignore" />
                            <ui:VisualElement class="breed-filters">
                                <ui:Button name="filter-fathers" text="Padres" class="breed-filter mm-button" />
                                <ui:Button name="filter-mothers" text="Madres" class="breed-filter mm-button" />
                            </ui:VisualElement>
                            <ui:VisualElement class="breed-grid-host">
                                <ui:ScrollView name="candidate-grid" class="breed-grid" mode="Vertical" />
                                <ui:Label name="candidate-empty" text="" class="breed-empty" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="breed-result">

                            <ui:VisualElement class="breed-pair mm-panel mm-panel--compact">
                                <ui:VisualElement class="mm-layer mm-panel__lip" picking-mode="Ignore" />
                                <ui:VisualElement class="mm-layer mm-panel__frame" picking-mode="Ignore" />

                                <ui:VisualElement name="father-slot" class="breed-slot breed-slot--empty">
                                    <ui:Label text="Padre" class="breed-slot-role mm-section" />
                                    <ui:VisualElement class="breed-portrait mm-slot">
                                        <ui:VisualElement class="mm-layer mm-slot__vignette" picking-mode="Ignore" />
                                        <ui:VisualElement class="mm-layer breed-runes" picking-mode="Ignore" />
                                        <ui:VisualElement name="father-slot-img" class="breed-slot-img" picking-mode="Ignore" />
                                        <ui:VisualElement class="mm-layer mm-slot__frame" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:Label name="father-slot-name" text="Vacío" class="breed-slot-name" />
                                </ui:VisualElement>

                                <ui:VisualElement class="breed-link" picking-mode="Ignore">
                                    <ui:VisualElement class="mm-icon mm-icon--affect breed-link__icon" picking-mode="Ignore" />
                                </ui:VisualElement>

                                <ui:VisualElement name="mother-slot" class="breed-slot breed-slot--empty">
                                    <ui:Label text="Madre" class="breed-slot-role mm-section" />
                                    <ui:VisualElement class="breed-portrait mm-slot">
                                        <ui:VisualElement class="mm-layer mm-slot__vignette" picking-mode="Ignore" />
                                        <ui:VisualElement class="mm-layer breed-runes" picking-mode="Ignore" />
                                        <ui:VisualElement name="mother-slot-img" class="breed-slot-img" picking-mode="Ignore" />
                                        <ui:VisualElement class="mm-layer mm-slot__frame" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:Label name="mother-slot-name" text="Vacío" class="breed-slot-name" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <ui:VisualElement class="breed-inherit mm-panel mm-panel--compact">
                                <ui:VisualElement class="mm-layer mm-panel__lip" picking-mode="Ignore" />
                                <ui:VisualElement class="mm-layer mm-panel__frame" picking-mode="Ignore" />
                                <ui:Label name="inherit-title" text="Herencia" class="breed-inherit-title mm-section mm-section--ornate" />
                                <ui:VisualElement name="inherit-list" class="inherit-list" />
                            </ui:VisualElement>

                            <ui:VisualElement class="breed-foot">
                                <ui:VisualElement class="mm-row breed-egg__time">
                                    <ui:VisualElement class="mm-icon breed-time-icon" />
                                    <ui:Label name="time-label" text="" class="breed-time" />
                                </ui:VisualElement>
                                <ui:Button name="breed-button" text="Breed" class="breed-action mm-button mm-button--big" />
                            </ui:VisualElement>

                        </ui:VisualElement>

                    </ui:VisualElement>
                </ui:Tab>

                <ui:Tab label="Incubando" name="tab-incubando">
                    <ui:VisualElement class="page-panel mm-panel">
                        <ui:VisualElement class="mm-layer mm-panel__lip" picking-mode="Ignore" />
                        <ui:VisualElement class="mm-layer mm-panel__frame" picking-mode="Ignore" />
                        <ui:VisualElement class="egg-empty" picking-mode="Ignore" />
                        <ui:ScrollView name="egg-list" class="egg-list" mode="Vertical" />
                    </ui:VisualElement>
                </ui:Tab>

            </ui:TabView>

            <ui:Label name="title" text="Crianza" class="breed-title mm-title" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement class="mm-footer" picking-mode="Ignore">
            <ui:VisualElement class="mm-prompt">
                <ui:Label text="A" class="mm-key" />
                <ui:Label text="D" class="mm-key" style="margin-left: 4px;" />
                <ui:Label name="prompt-tab" text="Pestaña" class="mm-prompt__label" />
            </ui:VisualElement>
            <ui:VisualElement class="mm-prompt">
                <ui:Label text="←↑↓→" class="mm-key" />
                <ui:Label name="prompt-move" text="Mover" class="mm-prompt__label" />
            </ui:VisualElement>
            <ui:VisualElement class="mm-prompt">
                <ui:Label text="Enter" class="mm-key" />
                <ui:Label name="prompt-select" text="Elegir" class="mm-prompt__label" />
            </ui:VisualElement>
            <ui:Button name="close-button" text="" class="mm-prompt mm-prompt--button">
                <ui:Label text="Esc" class="mm-key" picking-mode="Ignore" />
                <ui:Label name="prompt-close" text="Cerrar" class="mm-prompt__label" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
