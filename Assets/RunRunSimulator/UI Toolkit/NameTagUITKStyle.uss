.tag {
    align-items: center;
    align-self: center;
    padding: 6px 16px 6px 16px;
    background-color: transparent;
    border-width: 0;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Box_Rounded_Medium_02.png");
    -unity-background-image-tint-color: rgba(43, 40, 36, 0.55);
    -unity-slice-scale: 0.12;
}

.tag Label {
    -unity-font-definition: url("Skin/Fonts/AlegreyaSans-Medium.ttf");
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.85);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.tag .tag__name {
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 22px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1.2px;
    -unity-text-outline-color: rgb(31, 25, 18);
}

.tag__row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.tag__row Label {
    font-size: 14px;
    margin: 0 5px;
}

.tag__price {
    display: none;
    color: rgb(255, 214, 120);
}

.tag__status {
    -unity-font-style: bold;
}

.tag__intent {
    color: rgb(150, 200, 235);
}

.tag__gender {
    display: none;
    -unity-font-style: bold;
}

.tag__role {
    display: none;
    color: rgb(200, 200, 210);
}

.tag__stage {
    display: none;
    color: rgb(180, 200, 180);
}

.tag__breed {
    display: none;
    color: rgb(150, 235, 170);
    -unity-font-style: bold;
}

.tag__heart {
    display: none;
    color: rgb(235, 70, 90);
}

.tag__timer {
    display: none;
    color: rgb(255, 190, 210);
    -unity-font-style: bold;
}
