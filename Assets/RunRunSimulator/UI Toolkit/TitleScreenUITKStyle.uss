.title-root {
    align-items: center;
    justify-content: center;
}

.title-menu {
    width: 760px;
    align-items: center;
    justify-content: center;
    padding: 0 0 30px 0;
}

.title-logo-wrap {
    width: 760px;
    height: 290px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.title-emblem {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 470px;
    height: 470px;
    margin-left: -235px;
    margin-top: -235px;
    background-image: url("Skin/Synty/SPR_FantasyMenus_Ring_Medium_01.png");
    -unity-background-image-tint-color: rgba(227, 187, 113, 0.42);
}

.title-logo {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.title-logo-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    height: 124px;
}

.title-letter {
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    height: 124px;
    font-size: 124px;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 5px;
    -unity-text-outline-color: rgb(3, 20, 17);
    white-space: nowrap;
    text-shadow: 0 6px 0 rgba(0, 0, 0, 0.55);
    opacity: 0;
    translate: 0 -60px;
    scale: 0.4 0.4;
    transition-property: opacity, translate, scale, rotate;
    transition-duration: 0.55s;
    transition-timing-function: ease-out-back;
}

.title-letter--a {
    color: var(--mm-section);
}

.title-letter--b {
    color: rgb(255, 246, 228);
}

.title-letter--in {
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
    rotate: 0deg;
}

.title-letter--idle {
    transition-duration: 0s;
}

.title-tagline-wrap {
    width: 640px;
    flex-shrink: 0;
    align-items: center;
    margin-bottom: 18px;
}

.title-ornament {
    width: 420px;
    height: 105px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.title-ornament--top {
    background-image: url("Skin/Synty/SPR_FantasyMenus_Menu_Item_01_Top.png");
    margin-bottom: -22px;
}

.title-ornament--bottom {
    background-image: url("Skin/Synty/SPR_FantasyMenus_Menu_Item_01_Bottom.png");
    margin-top: -12px;
}

.title-tagline {
    margin: 0;
    padding: 0 12px;
    font-size: 30px;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(255, 255, 255);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.7);
}

.title-button {
    width: 460px;
    min-height: 66px;
    margin: 7px 0;
    flex-shrink: 0;
    padding: 0 30px;
}

.title-button--primary.title-button--breathe {
    scale: 1.035 1.035;
    transition-property: scale;
    transition-duration: 1.3s;
    transition-timing-function: ease-in-out;
}

.title-button--danger {
    -unity-background-image-tint-color: var(--mm-coral-dark);
    color: rgb(255, 255, 255);
}

.title-button--danger:hover {
    -unity-background-image-tint-color: var(--mm-coral);
    color: rgb(255, 255, 255);
}

.title-slide {
    transition-property: opacity, translate;
    transition-duration: 0.5s;
    transition-timing-function: ease-out-back;
}

.title-slide--hidden {
    opacity: 0;
    translate: -80px 0;
}

.title-tagline.title-slide {
    transition-timing-function: ease-out;
}

.title-tagline.title-slide--hidden {
    translate: -40px 0;
}

.title-confirm {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(2, 12, 10, 0.78);
    display: none;
}

.title-confirm-panel {
    width: 700px;
    max-width: 92%;
    align-items: stretch;
}

.title-confirm-text {
    font-size: 26px;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(255, 255, 255);
    margin: 0 0 4px 0;
}

.title-confirm-panel > .mm-bar {
    margin: 14px 0 18px 0;
}

.title-confirm-row {
    flex-direction: row;
    justify-content: center;
}

.title-confirm-button {
    width: auto;
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 8px;
    padding: 0 16px;
    font-size: 23px;
    white-space: normal;
}

.title-version {
    position: absolute;
    right: 20px;
    bottom: 12px;
    margin: 0;
    padding: 0;
    font-size: 17px;
    color: var(--mm-ink-soft);
    -unity-text-align: lower-right;
}

.title-fade {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.6s;
    transition-timing-function: ease-in-out;
}

.title-fade--black {
    opacity: 1;
}

.title-fade--leave {
    opacity: 1;
    transition-duration: 0.45s;
}
