.overlay-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.orders {
    position: absolute;
    top: 24px;
    left: 24px;
    max-width: 460px;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Box_Rounded_Medium_02.png");
    -unity-background-image-tint-color: var(--hud-pill);
    -unity-slice-scale: 0.2;
    padding: 12px 18px 10px 18px;
    display: none;
}

.orders-title {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 22px;
    color: var(--hud-gold);
    margin-bottom: 6px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
}

.orders-list {
    flex-direction: column;
}

.orders-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.orders-bullet {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: var(--hud-gold);
    margin-right: 10px;
}

.orders-text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    font-size: 20px;
    color: rgb(255, 255, 255);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
}

.orders-reward {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 14px;
}

.orders-reward__amount {
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 20px;
    color: var(--hud-gold);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
}

.orders-reward__coin {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    margin-left: 2px;
    background-image: url("Skin/Synty/ICON_SM_Item_Coins_02_Dungeon.png");
    -unity-background-scale-mode: scale-to-fit;
}

.crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 10px;
    translate: -50% -50%;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Reticle_Dot_01.png");
    -unity-background-image-tint-color: rgb(240, 230, 200);
    -unity-background-scale-mode: scale-to-fit;
    transition-property: width, height, -unity-background-image-tint-color;
    transition-duration: 0.12s;
}

.crosshair--target {
    width: 34px;
    height: 34px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Reticle_Ring01_Sml.png");
    -unity-background-image-tint-color: var(--hud-gold);
}

.focus-prompt {
    position: absolute;
    left: 50%;
    top: 50%;
    margin-top: 36px;
    translate: -50% 0;
    align-items: flex-start;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Box_Rounded_Medium_02.png");
    -unity-background-image-tint-color: var(--hud-pill);
    -unity-slice-scale: 0.2;
    padding: 8px 14px 4px 14px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.12s;
}

.focus-prompt--visible {
    opacity: 1;
}

.focus-title {
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 22px;
    color: rgb(255, 255, 255);
    margin-bottom: 2px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.85);
}

.focus-detail {
    -unity-font-definition: url("Skin/Fonts/AlegreyaSans-Medium.ttf");
    font-size: 18px;
    color: var(--hud-gold);
    margin-bottom: 4px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.85);
}

.focus-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.focus-key {
    min-width: 34px;
    -unity-text-align: middle-center;
    margin-right: 10px;
    color: var(--hud-gold);
}

.focus-action {
    font-size: 20px;
    color: rgb(255, 255, 255);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.85);
}

.overlay-top-right {
    position: absolute;
    top: 22px;
    right: 22px;
    align-items: flex-end;
}

.overlay-date {
    background-image: url("Skin/Synty/SPR_FantasyScreens_Bar_Rounded_01.png");
    -unity-background-image-tint-color: var(--hud-pill);
    -unity-slice-scale: 0.4;
    padding: 6px 22px;
    margin-bottom: 8px;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 26px;
    color: rgb(255, 255, 255);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
}

.overlay-currency {
    flex-direction: row;
    align-items: center;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Bar_Rounded_01.png");
    -unity-background-image-tint-color: var(--hud-pill);
    -unity-slice-scale: 0.4;
    padding: 2px 18px 2px 6px;
    margin-bottom: 6px;
}

.overlay-currency__icon {
    width: 40px;
    height: 40px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.overlay-currency__icon--coin {
    background-image: url("Skin/Synty/ICON_SM_Item_Coins_02_Dungeon.png");
}

.overlay-currency__icon--gem {
    background-image: url("Skin/Synty/ICON_SM_Item_Crystal_02.png");
}

.overlay-dabloons {
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 22px;
    color: rgb(255, 255, 255);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
}

.expedition-toast {
    position: absolute;
    top: 22px;
    left: 50%;
    translate: -50% 0;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Bar_Rounded_01.png");
    -unity-background-image-tint-color: var(--hud-pill);
    -unity-slice-scale: 0.4;
    padding: 8px 28px;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 22px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    display: none;
}

.toast--win {
    color: var(--mm-good);
}

.toast--lose {
    color: var(--mm-crit);
}

.toast--draw {
    color: var(--mm-warn);
}
