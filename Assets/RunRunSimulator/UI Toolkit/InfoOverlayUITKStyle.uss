.overlay-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.overlay-hints {
    position: absolute;
    top: 22px;
    left: 22px;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Box_Rounded_Medium_02.png");
    -unity-background-image-tint-color: var(--hud-pill);
    -unity-slice-scale: 0.15;
    padding: 12px 16px;
}

.hint-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.hint-key {
    min-width: 64px;
    height: 28px;
    padding: 0 8px;
    margin-right: 10px;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Box_Rounded_Medium_02.png");
    -unity-background-image-tint-color: var(--hud-key);
    -unity-slice-scale: 0.12;
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 18px;
    color: var(--hud-gold);
    -unity-text-align: middle-center;
}

.hint-action {
    font-size: 18px;
    color: rgb(255, 255, 255);
}

.lang-row {
    flex-direction: row;
    justify-content: flex-start;
    margin-top: 8px;
}

.lang-btn {
    min-width: 46px;
    height: 30px;
    padding: 0 8px;
    margin: 0 8px 0 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Skin/Synty/SPR_FantasyScreens_Box_Rounded_Medium_02.png");
    -unity-background-image-tint-color: var(--hud-key);
    -unity-slice-scale: 0.12;
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 17px;
    color: rgb(255, 255, 255);
}

.lang-btn:hover {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: var(--hud-slot);
}

.lang-btn--active {
    -unity-background-image-tint-color: var(--hud-gold);
    color: var(--hud-bubble-ink);
}

.overlay-top-right {
    position: absolute;
    top: 22px;
    right: 22px;
    align-items: flex-end;
}

.overlay-date {
    background-image: url("Skin/Synty/SPR_FantasyScreens_Bar_Rounded_01.png");
    -unity-background-image-tint-color: var(--hud-pill);
    -unity-slice-scale: 0.4;
    padding: 6px 22px;
    margin-bottom: 8px;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 26px;
    color: rgb(255, 255, 255);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
}

.overlay-currency {
    flex-direction: row;
    align-items: center;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Bar_Rounded_01.png");
    -unity-background-image-tint-color: var(--hud-pill);
    -unity-slice-scale: 0.4;
    padding: 2px 18px 2px 6px;
    margin-bottom: 6px;
}

.overlay-currency__icon {
    width: 40px;
    height: 40px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.overlay-currency__icon--coin {
    background-image: url("Skin/Synty/ICON_SM_Item_Coins_02_Dungeon.png");
}

.overlay-currency__icon--gem {
    background-image: url("Skin/Synty/ICON_SM_Item_Crystal_02.png");
}

.overlay-dabloons {
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 22px;
    color: rgb(255, 255, 255);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
}

.expedition-toast {
    position: absolute;
    top: 22px;
    left: 50%;
    translate: -50% 0;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Bar_Rounded_01.png");
    -unity-background-image-tint-color: var(--hud-pill);
    -unity-slice-scale: 0.4;
    padding: 8px 28px;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 22px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    display: none;
}

.toast--win {
    color: var(--mm-good);
}

.toast--lose {
    color: var(--mm-crit);
}

.toast--draw {
    color: var(--mm-warn);
}
