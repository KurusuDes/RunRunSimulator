.breed-window {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 62px;
    padding: 0 48px 18px 48px;
}

.breed-tabs {
    flex-grow: 1;
}

.breed-tabs .unity-tab-view__content-container,
.breed-tabs .unity-tab__content-container {
    flex-grow: 1;
}

.breed-tabs.tabbar-focused .unity-tab__header:checked {
    -unity-background-image-tint-color: rgba(70, 255, 190, 0.8);
}

.breed-title {
    position: absolute;
    left: 48px;
    top: 0;
    height: 76px;
    -unity-text-align: middle-left;
}

.criar-content {
    flex-direction: row;
    flex-grow: 1;
    align-items: stretch;
}

.breed-side {
    width: 480px;
    flex-shrink: 0;
}

.breed-col-title {
    margin-top: 0;
    margin-bottom: 14px;
}

.breed-list {
    flex-grow: 1;
}

.breed-center {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 24px;
}

.breed-slots {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
}

.breed-slot {
    width: 340px;
    flex-shrink: 0;
    align-items: center;
    -unity-background-image-tint-color: var(--mm-panel-fill);
}

.breed-slot:hover {
    -unity-background-image-tint-color: rgba(18, 62, 55, 0.96);
}

.breed-slot.breed-focus {
    -unity-background-image-tint-color: rgba(3, 64, 52, 0.98);
}

.breed-slot.breed-focus > .mm-panel__frame {
    -unity-background-image-tint-color: rgb(255, 236, 170);
}

.breed-slot.breed-focus > .mm-panel__lip {
    -unity-background-image-tint-color: rgba(96, 255, 200, 0.75);
}

.breed-slot-role {
    margin: 0 0 12px 0;
    font-size: 27px;
    -unity-text-align: middle-center;
}

.breed-portrait {
    width: 240px;
    height: 240px;
    margin-bottom: 12px;
}

.breed-slot-img {
    position: absolute;
    left: 6px;
    right: 6px;
    top: 6px;
    bottom: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.breed-slot-name {
    width: 100%;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 26px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.breed-link {
    width: 72px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.breed-link__icon {
    width: 56px;
    height: 56px;
    -unity-background-scale-mode: scale-to-fit;
}

.breed-result {
    flex-grow: 1;
    margin-top: 18px;
}

.breed-egg {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.breed-egg__box {
    width: 74px;
    height: 74px;
}

.breed-egg__icon {
    width: 50px;
    height: 50px;
    background-image: url("Skin/Synty/SPR_FantasyWarrior_Gem_09.png");
    -unity-background-scale-mode: scale-to-fit;
}

.breed-egg__time {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 74px;
    margin: 0 18px;
    padding: 6px 18px;
}

.breed-time-icon {
    width: 40px;
    height: 40px;
    margin-right: 14px;
    background-image: url("Skin/Synty/ICON_FantasyWarrior_Status_Time_01_Clean.png");
    -unity-background-image-tint-color: rgb(250, 208, 136);
    -unity-background-scale-mode: scale-to-fit;
}

.breed-time {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 24px;
    color: var(--mm-ink);
    white-space: normal;
    flex-shrink: 1;
}

.breed-action {
    min-width: 230px;
    margin: 0;
}

.breed-action.breed-focus {
    -unity-background-image-tint-color: rgb(255, 236, 170);
    scale: 1.05 1.05;
}

.breed-action--busy,
.breed-action--busy:hover {
    opacity: 0.45;
}

.breed-preview {
    flex-direction: row;
    flex-grow: 1;
    margin-top: 16px;
    background-image: url("Skin/Synty/SPR_FantasyWarrior_Gem_09.png");
    background-position: center center;
    background-repeat: no-repeat;
    background-size: 120px 120px;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.1);
}

.preview-parent {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin: 0 6px;
    padding: 12px 16px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Medium_Parchment02.png");
    -unity-background-image-tint-color: var(--mm-row-fill);
    -unity-slice-scale: 0.22;
}

.preview-name {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 25px;
    color: var(--mm-section);
    margin-bottom: 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.preview-part-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
}

.preview-swatch {
    width: 30px;
    height: 30px;
    margin-right: 10px;
    flex-shrink: 0;
    border-radius: 6px;
}

.preview-icon {
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.preview-icon--horn { -unity-background-image-tint-color: var(--mm-gold); }
.preview-icon--back { -unity-background-image-tint-color: var(--mm-teal); }
.preview-icon--wing { -unity-background-image-tint-color: var(--mm-plum); }

.preview-part-text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 19px;
    color: var(--mm-ink);
    white-space: normal;
}

.breed-candidate {
    flex-direction: row;
    align-items: center;
    min-height: 64px;
    margin-bottom: 8px;
    padding: 8px 14px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Medium_Parchment02.png");
    -unity-background-image-tint-color: var(--mm-row-fill);
    -unity-slice-scale: 0.22;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

.breed-candidate:hover {
    -unity-background-image-tint-color: rgba(18, 62, 55, 0.95);
}

.breed-candidate.breed-focus {
    -unity-background-image-tint-color: var(--mm-tab-fill-on);
    border-color: var(--mm-gold);
}

.breed-candidate-text {
    flex-grow: 1;
    flex-shrink: 1;
    padding-left: 54px;
    min-height: 44px;
    -unity-text-align: middle-left;
    font-size: 23px;
    color: var(--mm-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    background-position: left center;
    background-repeat: no-repeat;
    background-size: 40px 40px;
}

.breed-side--father .breed-candidate-text {
    background-image: url("Skin/Synty/ICON_FantasyWarrior_Status_Attack_01_Clean.png");
    -unity-background-image-tint-color: rgb(232, 112, 80);
}

.breed-side--mother .breed-candidate-text {
    background-image: url("Skin/Synty/ICON_FantasyWarrior_Status_Health_02_Clean.png");
    -unity-background-image-tint-color: rgb(240, 140, 200);
}

.page-panel {
    flex-grow: 1;
    margin: 0 220px;
}

.egg-empty {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("Skin/Synty/SPR_FantasyWarrior_Gem_09.png");
    background-position: center center;
    background-repeat: no-repeat;
    background-size: 200px 200px;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.1);
}

.egg-list {
    flex-grow: 1;
}

.egg-row {
    flex-direction: row;
    align-items: center;
    min-height: 96px;
    margin-bottom: 10px;
    padding: 12px 18px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Medium_Parchment02.png");
    -unity-background-image-tint-color: var(--mm-row-fill);
    -unity-slice-scale: 0.22;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

.egg-row.breed-focus {
    -unity-background-image-tint-color: var(--mm-tab-fill-on);
    border-color: var(--mm-gold);
}

.egg-pair {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 52px;
    padding-left: 62px;
    -unity-text-align: middle-left;
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 27px;
    color: rgb(255, 255, 255);
    white-space: normal;
    background-image: url("Skin/Synty/SPR_FantasyWarrior_Gem_09.png");
    background-position: left center;
    background-repeat: no-repeat;
    background-size: 48px 48px;
}

.egg-time {
    min-width: 170px;
    min-height: 46px;
    margin: 0 18px;
    padding: 2px 16px;
    flex-shrink: 0;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Small_Parchment_02.png");
    -unity-background-image-tint-color: rgb(1, 14, 12);
    -unity-slice-scale: 0.45;
    -unity-text-align: middle-center;
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--mm-section);
}

.egg-hatch {
    min-width: 200px;
    min-height: 54px;
    margin: 0;
    padding: 0 22px;
    flex-shrink: 0;
    background-image: url("Skin/Synty/SPR_FantasyMenus_Box_Small_Parchment_03.png");
    -unity-background-image-tint-color: var(--mm-gold);
    -unity-slice-scale: 0.35;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--mm-ink-dark);
    -unity-text-align: middle-center;
    transition-property: scale, -unity-background-image-tint-color;
    transition-duration: 0.12s;
}

.egg-hatch:hover {
    -unity-background-image-tint-color: rgb(250, 214, 150);
    background-color: rgba(0, 0, 0, 0);
    scale: 1.03 1.03;
}

.egg-hatch:active {
    scale: 0.97 0.97;
    background-color: rgba(0, 0, 0, 0);
}

.egg-hatch:focus {
    background-color: rgba(0, 0, 0, 0);
}

.egg-hatch--minerita {
    -unity-background-image-tint-color: var(--mm-tab-fill-on);
    color: var(--mm-ink);
}

.egg-hatch--minerita:hover {
    -unity-background-image-tint-color: rgb(20, 168, 128);
}

.egg-hatch:disabled,
.egg-hatch--busy,
.egg-hatch--busy:hover,
.egg-hatch--minerita.egg-hatch--busy,
.egg-hatch--minerita.egg-hatch--busy:hover {
    opacity: 0.45;
    scale: 1 1;
}

.egg-hatch--minerita.egg-hatch--busy,
.egg-hatch--minerita.egg-hatch--busy:hover {
    -unity-background-image-tint-color: var(--mm-tab-fill-on);
}
