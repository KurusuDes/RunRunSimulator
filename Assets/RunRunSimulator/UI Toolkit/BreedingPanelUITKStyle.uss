.breed-window {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 62px;
    padding: 0 48px 18px 48px;
}

.breed-tabs {
    flex-grow: 1;
}

.breed-tabs .unity-tab-view__content-container,
.breed-tabs .unity-tab__content-container {
    flex-grow: 1;
}

.breed-tabs.tabbar-focused .unity-tab__header:checked {
    -unity-background-image-tint-color: rgba(70, 255, 190, 0.8);
}

.breed-title {
    position: absolute;
    left: 48px;
    top: 0;
    height: 76px;
    -unity-text-align: middle-left;
}

.criar-content {
    flex-direction: row;
    flex-grow: 1;
    align-items: stretch;
}

.breed-picker {
    width: 760px;
    flex-shrink: 0;
    padding: 40px 34px 34px 34px;
}

.breed-filters {
    flex-direction: row;
    justify-content: center;
    flex-shrink: 0;
    margin-bottom: 14px;
}

.breed-filter {
    min-width: 220px;
    -unity-background-image-tint-color: var(--mm-tab-fill);
    color: var(--mm-ink);
}

.breed-filter:hover {
    -unity-background-image-tint-color: var(--mm-tab-fill-on);
}

.breed-filter.mm-button--selected {
    -unity-background-image-tint-color: var(--mm-tab-fill-on);
    color: rgb(255, 255, 255);
}

.breed-grid-host {
    flex-grow: 1;
}

.breed-grid {
    flex-grow: 1;
}

.breed-grid .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.breed-empty {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 26px;
    color: var(--mm-ink-soft);
    white-space: normal;
    display: none;
}

.breed-tile {
    width: 150px;
    margin: 5px;
    align-items: center;
    transition-property: scale;
    transition-duration: 0.12s;
}

.breed-tile__slot {
    width: 120px;
    height: 120px;
    margin-bottom: 8px;
}

.breed-tile__img {
    position: absolute;
    left: 4px;
    right: 4px;
    top: 4px;
    bottom: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.breed-tile__name {
    width: 100%;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 19px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.breed-tile__count {
    font-size: 16px;
    color: var(--mm-ink-soft);
    -unity-text-align: middle-center;
}

.breed-tile:hover .mm-slot__frame {
    -unity-background-image-tint-color: rgb(250, 214, 150);
}

.breed-tile.breed-focus {
    scale: 1.06 1.06;
}

.breed-tile.breed-focus .mm-slot__frame {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.breed-tile--chosen .mm-slot__frame {
    -unity-background-image-tint-color: rgb(255, 196, 60);
}

.breed-tile--chosen .breed-tile__name {
    color: var(--mm-section);
}

.breed-result {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 24px;
}

.breed-pair {
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    flex-shrink: 0;
    padding: 28px 34px 24px 34px;
}

.breed-slot {
    width: 300px;
    flex-shrink: 0;
    align-items: center;
}

.breed-slot-role {
    margin: 0 0 12px 0;
    font-size: 27px;
    -unity-text-align: middle-center;
}

.breed-portrait {
    width: 220px;
    height: 220px;
    margin-bottom: 12px;
}

.breed-runes {
    left: 28px;
    right: 28px;
    top: 28px;
    bottom: 28px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Tracery_Diamond_01.png");
    -unity-background-image-tint-color: rgba(250, 208, 136, 0.22);
    -unity-background-scale-mode: scale-to-fit;
    display: none;
}

.breed-slot--empty .breed-runes {
    display: flex;
}

.breed-slot:hover .mm-slot__frame {
    -unity-background-image-tint-color: rgb(250, 214, 150);
}

.breed-slot-img {
    position: absolute;
    left: 6px;
    right: 6px;
    top: 6px;
    bottom: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.breed-slot-name {
    width: 100%;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 26px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.breed-slot--empty .breed-slot-name {
    color: var(--mm-ink-soft);
}

.breed-link {
    width: 72px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.breed-link__icon {
    width: 56px;
    height: 56px;
    -unity-background-scale-mode: scale-to-fit;
}

.breed-inherit {
    flex-grow: 1;
    flex-shrink: 1;
    margin-top: 14px;
    padding: 30px 34px 24px 34px;
}

.breed-inherit-title {
    margin: 0 0 12px 0;
    flex-shrink: 0;
}

.inherit-list {
    flex-shrink: 1;
}

.inherit-row {
    min-height: 46px;
    margin-bottom: 4px;
    padding: 3px 10px;
}

.inherit-row__box {
    width: 42px;
    height: 42px;
}

.inherit-row__box .mm-icon {
    width: 28px;
    height: 28px;
    -unity-background-scale-mode: scale-to-fit;
}

.inherit-icon--horn {
    background-image: url("Skin/Synty/ICON_FantasyWarrior_Status_Attack_01_Clean.png");
    -unity-background-image-tint-color: rgb(232, 112, 80);
}

.inherit-icon--back {
    background-image: url("Skin/Synty/ICON_FantasyWarrior_Status_Health_02_Clean.png");
    -unity-background-image-tint-color: rgb(64, 196, 164);
}

.inherit-icon--wing {
    background-image: url("Skin/Synty/ICON_FantasyWarrior_Status_SpeedUp_01_Clean.png");
    -unity-background-image-tint-color: rgb(250, 208, 96);
}

.inherit-icon--face {
    background-image: url("Skin/Synty/ICON_FantasyWarrior_Status_Charmed_01_Clean.png");
    -unity-background-image-tint-color: rgb(240, 140, 200);
}

.inherit-icon--body {
    background-image: url("Skin/Synty/SPR_FantasyWarrior_Gem_09.png");
}

.inherit-row__role {
    width: 120px;
    margin-left: 12px;
    flex-shrink: 0;
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 23px;
    color: var(--mm-section);
}

.inherit-cell {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    margin-left: 8px;
    padding: 4px 10px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 6px;
}

.inherit-cell--same {
    background-color: rgba(64, 196, 164, 0.2);
    border-color: var(--mm-teal);
}

.inherit-cell__swatch {
    width: 22px;
    height: 22px;
    margin-right: 10px;
    flex-shrink: 0;
    border-radius: 5px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.55);
}

.inherit-cell__text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 21px;
    color: var(--mm-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.breed-foot {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-top: 14px;
}

.breed-egg__time {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 60px;
    margin: 0 18px 0 0;
    padding: 6px 18px;
}

.breed-time-icon {
    width: 40px;
    height: 40px;
    margin-right: 14px;
    background-image: url("Skin/Synty/ICON_FantasyWarrior_Status_Time_01_Clean.png");
    -unity-background-image-tint-color: rgb(250, 208, 136);
    -unity-background-scale-mode: scale-to-fit;
}

.breed-time {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 24px;
    color: var(--mm-ink);
    white-space: normal;
    flex-shrink: 1;
}

.breed-action {
    min-width: 280px;
    min-height: 68px;
    margin: 0;
}

.breed-action.breed-focus {
    -unity-background-image-tint-color: rgb(255, 236, 170);
    scale: 1.05 1.05;
}

.page-panel {
    flex-grow: 1;
    margin: 0 220px;
}

.egg-empty {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("Skin/Synty/SPR_FantasyWarrior_Gem_09.png");
    background-position: center center;
    background-repeat: no-repeat;
    background-size: 200px 200px;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.1);
}

.egg-list {
    flex-grow: 1;
}

.egg-row {
    flex-direction: row;
    align-items: center;
    min-height: 96px;
    margin-bottom: 10px;
    padding: 12px 18px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Medium_Parchment02.png");
    -unity-background-image-tint-color: var(--mm-row-fill);
    -unity-slice-scale: 0.22;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

.egg-row.breed-focus {
    -unity-background-image-tint-color: var(--mm-tab-fill-on);
    border-color: var(--mm-gold);
}

.egg-pair {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 52px;
    padding-left: 62px;
    -unity-text-align: middle-left;
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 27px;
    color: rgb(255, 255, 255);
    white-space: normal;
    background-image: url("Skin/Synty/SPR_FantasyWarrior_Gem_09.png");
    background-position: left center;
    background-repeat: no-repeat;
    background-size: 48px 48px;
}

.egg-time {
    min-width: 170px;
    min-height: 46px;
    margin: 0 18px;
    padding: 2px 16px;
    flex-shrink: 0;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Small_Parchment_02.png");
    -unity-background-image-tint-color: rgb(1, 14, 12);
    -unity-slice-scale: 0.45;
    -unity-text-align: middle-center;
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--mm-section);
}

.egg-hatch {
    min-width: 200px;
    min-height: 54px;
    margin: 0;
    padding: 0 22px;
    flex-shrink: 0;
    background-image: url("Skin/Synty/SPR_FantasyMenus_Box_Small_Parchment_03.png");
    -unity-background-image-tint-color: var(--mm-gold);
    -unity-slice-scale: 0.35;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--mm-ink-dark);
    -unity-text-align: middle-center;
    transition-property: scale, -unity-background-image-tint-color;
    transition-duration: 0.12s;
}

.egg-hatch:hover {
    -unity-background-image-tint-color: rgb(250, 214, 150);
    background-color: rgba(0, 0, 0, 0);
    scale: 1.03 1.03;
}

.egg-hatch:active {
    scale: 0.97 0.97;
    background-color: rgba(0, 0, 0, 0);
}

.egg-hatch:focus {
    background-color: rgba(0, 0, 0, 0);
}

.egg-hatch--minerita {
    -unity-background-image-tint-color: var(--mm-tab-fill-on);
    color: var(--mm-ink);
}

.egg-hatch--minerita:hover {
    -unity-background-image-tint-color: rgb(20, 168, 128);
}

.egg-hatch:disabled,
.egg-hatch--busy,
.egg-hatch--busy:hover,
.egg-hatch--minerita.egg-hatch--busy,
.egg-hatch--minerita.egg-hatch--busy:hover {
    opacity: 0.45;
    scale: 1 1;
}

.egg-hatch--minerita.egg-hatch--busy,
.egg-hatch--minerita.egg-hatch--busy:hover {
    -unity-background-image-tint-color: var(--mm-tab-fill-on);
}
