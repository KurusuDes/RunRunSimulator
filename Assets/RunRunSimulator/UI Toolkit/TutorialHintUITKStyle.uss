.hint-root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: flex-start;
}

.hint-pill {
    flex-direction: row;
    align-items: center;
    margin-top: 28px;
    padding: 10px 28px 10px 12px;
    background-color: var(--mm-surface);
    border-width: 3px;
    border-color: var(--mm-frame);
    border-radius: 44px;
    opacity: 0;
    translate: 0 -30px;
    transition-property: opacity, translate;
    transition-duration: 0.35s, 0.35s;
    transition-timing-function: ease-out-back;
}

.hint-pill.hint--shown {
    opacity: 1;
    translate: 0 0;
}

.hint-badge {
    min-width: 64px;
    height: 64px;
    margin-right: 18px;
    padding: 0 10px;
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--mm-ink);
    background-color: var(--mm-gold);
    border-radius: 32px;
    scale: 1 1;
    transition-property: scale, background-color;
    transition-duration: 0.12s, 0.2s;
    transition-timing-function: ease-out;
}

.hint-badge.hint--done {
    color: rgb(255, 255, 255);
    background-color: var(--mm-good);
}

.hint-badge.hint--pop {
    scale: 1.2 1.2;
}

.hint-text {
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: nowrap;
    color: var(--mm-ink);
}
