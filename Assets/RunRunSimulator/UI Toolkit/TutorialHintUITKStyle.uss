.hint-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: flex-start;
}

.hint-pill {
    flex-direction: row;
    align-items: center;
    margin-top: 28px;
    padding: 8px 30px 8px 10px;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Bar_Rounded_01.png");
    -unity-background-image-tint-color: rgba(43, 40, 36, 0.82);
    -unity-slice-scale: 0.6;
    opacity: 0;
    translate: 0 -30px;
    transition-property: opacity, translate;
    transition-duration: 0.35s, 0.35s;
    transition-timing-function: ease-out-back;
}

.hint-pill.hint--shown {
    opacity: 1;
    translate: 0 0;
}

.hint-badge {
    min-width: 58px;
    height: 58px;
    margin-right: 16px;
    padding: 0 10px;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Box_Rounded_Medium_02.png");
    -unity-background-image-tint-color: var(--hud-gold);
    -unity-slice-scale: 0.2;
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 28px;
    -unity-text-align: middle-center;
    color: var(--hud-bubble-ink);
    scale: 1 1;
    transition-property: scale, -unity-background-image-tint-color;
    transition-duration: 0.12s, 0.2s;
    transition-timing-function: ease-out;
}

.hint-badge.hint--done {
    -unity-background-image-tint-color: var(--mm-good);
    color: rgb(255, 255, 255);
}

.hint-badge.hint--pop {
    scale: 1.2 1.2;
}

.hint-text {
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 26px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    color: rgb(255, 255, 255);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
}
