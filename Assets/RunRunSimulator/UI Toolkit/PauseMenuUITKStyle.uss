.pause-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    align-items: center;
    background-color: rgba(2, 12, 10, 0.72);
}

.pause-panel {
    width: 560px;
    margin-left: 150px;
    align-items: stretch;
    flex-shrink: 0;
}

.pause-title {
    font-size: 68px;
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0 0 0 6px;
}

.pause-panel > .mm-bar {
    margin: 10px 0 26px 0;
}

.pause-button {
    min-height: 72px;
    margin: 7px 0;
    padding: 0 30px;
    font-size: 27px;
}

.pause-button--danger:hover {
    -unity-background-image-tint-color: var(--mm-coral-dark);
    color: rgb(255, 255, 255);
}
