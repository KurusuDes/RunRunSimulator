.hotbar-root {
    position: absolute;
    bottom: 22px;
    left: 0;
    right: 0;
    align-items: center;
    justify-content: center;
}

.tug-meter {
    width: 380px;
    margin-bottom: 14px;
    align-items: center;
}

.tug-meter__label {
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 28px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.6);
    margin-bottom: 6px;
}

.tug-meter__track {
    width: 100%;
    height: 26px;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Bar_Rounded_01.png");
    -unity-background-image-tint-color: var(--hud-pill);
    -unity-slice-scale: 0.2;
    padding: 5px;
}

.tug-meter__fill {
    width: 50%;
    height: 100%;
    border-radius: 8px;
    background-color: var(--mm-good);
}

.tug-meter--losing .tug-meter__fill {
    background-color: var(--mm-crit);
}

.hotbar-slots {
    flex-direction: row;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Bar_Rounded_01.png");
    -unity-background-image-tint-color: var(--hud-pill);
    -unity-slice-scale: 0.5;
    padding: 10px 14px;
}

.hotbar-slot {
    width: 104px;
    height: 104px;
    margin: 0 5px;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Box_Rounded_Medium_01.png");
    -unity-background-image-tint-color: var(--hud-slot);
    -unity-slice-scale: 0.2;
    align-items: center;
    justify-content: center;
    padding: 6px;
    transition-property: scale, -unity-background-image-tint-color;
    transition-duration: 0.12s;
}

.hotbar-slot--active {
    -unity-background-image-tint-color: var(--hud-slot-active);
    scale: 1.08 1.08;
}

.hotbar-slot__index {
    position: absolute;
    top: -8px;
    left: -6px;
    min-width: 28px;
    height: 28px;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Box_Rounded_Medium_02.png");
    -unity-background-image-tint-color: var(--hud-key);
    -unity-slice-scale: 0.12;
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 18px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.hotbar-slot--active .hotbar-slot__index {
    -unity-background-image-tint-color: var(--hud-gold);
    color: var(--hud-bubble-ink);
}

.hotbar-slot__name {
    width: 100%;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    -unity-text-align: middle-center;
    white-space: normal;
    font-size: 17px;
    color: rgb(255, 255, 255);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
}
