.hotbar-root {
    position: absolute;
    bottom: 22px;
    left: 0;
    right: 0;
    align-items: center;
    justify-content: center;
}

.tug-meter {
    width: 380px;
    margin-bottom: 14px;
    align-items: center;
}

.tug-meter__label {
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 28px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.6);
    margin-bottom: 6px;
}

.tug-meter__track {
    width: 100%;
    height: 26px;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Bar_Rounded_01.png");
    -unity-background-image-tint-color: var(--hud-pill);
    -unity-slice-scale: 0.2;
    padding: 5px;
}

.tug-meter__fill {
    width: 50%;
    height: 100%;
    border-radius: 8px;
    background-color: var(--mm-good);
}

.tug-meter--losing .tug-meter__fill {
    background-color: var(--mm-crit);
}

.hotbar-slots {
    flex-direction: row;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Bar_Rounded_01.png");
    -unity-background-image-tint-color: rgba(43, 40, 36, 0.3);
    -unity-slice-scale: 0.5;
    padding: 18px 20px 16px 20px;
}

.hotbar-slot {
    width: 90px;
    margin: 0 3px;
    align-items: center;
}

.hotbar-slot__box {
    width: 80px;
    height: 80px;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Box_Rounded_Medium_01.png");
    -unity-background-image-tint-color: rgb(99, 75, 49);
    -unity-slice-scale: 0.2;
    transition-property: scale, -unity-background-image-tint-color;
    transition-duration: 0.12s;
}

.hotbar-slot__runes {
    position: absolute;
    left: 5px;
    top: 5px;
    width: 70px;
    height: 70px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Tracery_Diamond_01.png");
    -unity-background-image-tint-color: rgba(36, 32, 26, 0.6);
}

.hotbar-slot__icon {
    position: absolute;
    left: 0;
    top: 0;
    width: 80px;
    height: 80px;
    -unity-background-scale-mode: scale-to-fit;
}

.hotbar-slot__name {
    position: absolute;
    left: 0;
    top: 0;
    width: 80px;
    height: 80px;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    -unity-text-align: middle-center;
    white-space: normal;
    font-size: 15px;
    color: rgb(255, 255, 255);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
}

.hotbar-slot__frame {
    position: absolute;
    left: -6px;
    top: -1px;
    right: -6px;
    bottom: -11px;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Frame_Rounded_02.png");
    -unity-background-image-tint-color: var(--hud-gold);
    -unity-slice-scale: 0.25;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.12s;
}

.hotbar-slot__key {
    height: 25px;
    min-width: 28px;
    margin-top: 4px;
    padding: 0 8px;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Box_Rounded_Medium_02.png");
    -unity-background-image-tint-color: rgba(70, 62, 52, 0.95);
    -unity-slice-scale: 0.12;
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.hotbar-slot--active .hotbar-slot__box {
    -unity-background-image-tint-color: rgb(122, 92, 60);
    scale: 1.06 1.06;
}

.hotbar-slot--active .hotbar-slot__frame {
    opacity: 1;
}

.hotbar-slot--active .hotbar-slot__key {
    -unity-background-image-tint-color: var(--hud-gold);
    color: var(--hud-bubble-ink);
}
