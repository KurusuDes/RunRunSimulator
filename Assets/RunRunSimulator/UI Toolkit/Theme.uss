.mm-theme {
    --mm-bg: rgb(234, 211, 174);
    --mm-bg-deep: rgb(221, 191, 147);
    --mm-surface: rgb(251, 240, 220);
    --mm-surface-2: rgb(243, 225, 196);
    --mm-frame: rgb(94, 62, 41);
    --mm-frame-soft: rgb(185, 138, 99);
    --mm-ink: rgb(62, 42, 29);
    --mm-ink-soft: rgb(138, 106, 82);
    --mm-coral: rgb(239, 100, 64);
    --mm-coral-dark: rgb(194, 68, 40);
    --mm-teal: rgb(31, 158, 138);
    --mm-gold: rgb(233, 161, 31);
    --mm-plum: rgb(158, 79, 178);
    --mm-good: rgb(90, 166, 70);
    --mm-warn: rgb(231, 146, 51);
    --mm-crit: rgb(220, 74, 56);
    --mm-scrim: rgba(62, 42, 29, 0.45);
    --mm-ally: rgb(86, 140, 214);
    --mm-foe: rgb(214, 92, 92);
}

.mm-theme--night {
    --mm-bg: rgb(36, 26, 25);
    --mm-bg-deep: rgb(22, 15, 14);
    --mm-surface: rgb(51, 38, 36);
    --mm-surface-2: rgb(42, 31, 29);
    --mm-frame: rgb(199, 154, 110);
    --mm-frame-soft: rgb(122, 90, 70);
    --mm-ink: rgb(244, 227, 206);
    --mm-ink-soft: rgb(183, 154, 130);
    --mm-coral: rgb(255, 126, 88);
    --mm-coral-dark: rgb(226, 92, 60);
    --mm-teal: rgb(51, 191, 166);
    --mm-gold: rgb(245, 185, 72);
    --mm-plum: rgb(194, 115, 212);
    --mm-good: rgb(121, 192, 102);
    --mm-warn: rgb(231, 146, 51);
    --mm-crit: rgb(224, 90, 72);
    --mm-scrim: rgba(0, 0, 0, 0.55);
    --mm-ally: rgb(150, 200, 255);
    --mm-foe: rgb(255, 150, 140);
}

.mm-role {
    font-size: 13px;
    -unity-font-style: bold;
    padding: 2px 10px;
    border-radius: 10px;
    color: rgb(40, 26, 18);
    -unity-text-align: middle-center;
}

.mm-role--offense {
    background-color: var(--mm-coral);
}

.mm-role--control {
    background-color: var(--mm-plum);
}

.mm-role--support {
    background-color: var(--mm-good);
}

.mm-role--tank {
    background-color: var(--mm-gold);
}

.mm-role-ring--offense {
    border-color: var(--mm-coral);
}

.mm-role-ring--control {
    border-color: var(--mm-plum);
}

.mm-role-ring--support {
    border-color: var(--mm-good);
}

.mm-role-ring--tank {
    border-color: var(--mm-gold);
}

.mm-role-text--offense {
    color: var(--mm-coral);
}

.mm-role-text--control {
    color: var(--mm-plum);
}

.mm-role-text--support {
    color: var(--mm-good);
}

.mm-role-text--tank {
    color: var(--mm-gold);
}

.mm-rolepill {
    flex-direction: row;
    align-items: stretch;
    flex-shrink: 0;
    border-radius: 10px;
    overflow: hidden;
}

.mm-rolepill__seg {
    margin: 0;
    padding: 2px 8px;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    color: rgb(40, 26, 18);
}

.mm-rolepill__seg--minor {
    padding: 2px 7px;
    font-size: 11px;
}

.mm-role--balanced {
    background-color: var(--mm-frame-soft);
    color: var(--mm-ink);
}
