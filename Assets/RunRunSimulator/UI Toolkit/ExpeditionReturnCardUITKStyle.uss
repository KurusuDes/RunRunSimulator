.ret {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.ret-scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(3, 14, 12, 0.72);
}

.ret-panel {
    width: 1040px;
    max-width: 96%;
    max-height: 94%;
}

.ret-title {
    font-size: 56px;
    letter-spacing: 3px;
}

.ret-title--lost {
    color: var(--mm-crit);
}

.ret-body {
    align-items: center;
    padding: 4px 0 6px 0;
}

.ret-reward {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-width: 460px;
    padding: 12px 30px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Medium_Parchment02.png");
    -unity-background-image-tint-color: var(--mm-row-fill);
    -unity-slice-scale: 0.22;
}

.ret-reward__box {
    width: 84px;
    height: 84px;
    margin-right: 22px;
}

.ret-reward__gem {
    width: 54px;
    height: 54px;
    background-image: url("Skin/Synty/SPR_FantasyWarrior_Gem_09.png");
    -unity-background-scale-mode: scale-to-fit;
}

.ret-reward__text {
    align-items: flex-start;
}

.ret-minerita {
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 48px;
    color: var(--mm-teal);
}

.ret-rooms {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 24px;
    color: var(--mm-section);
}

.ret-lost {
    margin-top: 14px;
    padding: 8px 26px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Small_Parchment_02.png");
    -unity-background-image-tint-color: rgb(150, 40, 30);
    -unity-slice-scale: 0.45;
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 24px;
    color: rgb(255, 255, 255);
    white-space: normal;
    -unity-text-align: middle-center;
}

.ret-team {
    width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 18px;
}

.ret-card {
    width: 210px;
    margin: 8px 10px;
    padding: 20px 18px 16px 18px;
    align-items: center;
    background-color: var(--mm-slot-fill);
    background-image: url("Skin/Synty/SPR_FantasyMenus_Frame_Box_Small_01.png");
    -unity-background-image-tint-color: rgb(209, 205, 194);
    -unity-slice-scale: 0.22;
}

.ret-card--grew {
    background-color: rgb(8, 52, 44);
    -unity-background-image-tint-color: rgb(255, 232, 178);
}

.ret-card__icon {
    width: 100%;
    height: 150px;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(227, 187, 113, 0.4);
    background-color: rgb(40, 60, 56);
}

.ret-card--grew .ret-card__icon {
    border-color: var(--mm-gold);
}

.ret-card__name {
    width: 100%;
    margin-top: 8px;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 26px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    white-space: normal;
}

.ret-card__growth {
    width: 100%;
    min-height: 34px;
    margin-top: 8px;
    align-items: center;
    justify-content: center;
}

.ret-badge {
    padding: 2px 18px;
    min-height: 34px;
    background-image: url("Skin/Synty/SPR_FantasyMenus_Box_Small_Parchment_03.png");
    -unity-background-image-tint-color: var(--mm-gold);
    -unity-slice-scale: 0.35;
    color: var(--mm-ink-dark);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.ret-newpower {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
}

.ret-newpower__icon {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    margin-right: 8px;
    border-radius: 8px;
    background-color: var(--mm-bg-deep);
    -unity-background-scale-mode: scale-to-fit;
}

.ret-newpower__text {
    flex-shrink: 1;
    font-size: 18px;
    color: var(--mm-teal);
    white-space: normal;
}

.ret-pips {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.ret-pip {
    width: 20px;
    height: 20px;
    margin: 4px;
    border-radius: 10px;
    border-width: 2px;
    border-color: var(--mm-frame-soft);
    background-color: var(--mm-bg-deep);
}

.ret-pip--on {
    border-color: var(--mm-gold);
    background-color: var(--mm-gold);
}

.ret-note {
    margin-top: 12px;
    font-size: 20px;
    color: var(--mm-ink-soft);
    white-space: normal;
    -unity-text-align: middle-center;
}

.ret-actions {
    align-items: center;
    padding-top: 12px;
}

.ret-continue {
    min-width: 300px;
}
