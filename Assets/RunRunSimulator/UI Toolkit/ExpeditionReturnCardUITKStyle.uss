.ret {
    align-items: center;
}

.ret-content {
    flex-grow: 1;
    width: 100%;
    align-items: center;
    padding: 40px 80px 120px 80px;
}

.ret-title {
    font-size: 72px;
    letter-spacing: 4px;
}

.ret-title--lost {
    color: var(--mm-crit);
}

.ret-bar {
    width: 640px;
    align-self: center;
}

.ret-team {
    width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 6px;
}

.ret-card {
    width: 210px;
    margin: 8px 10px;
    padding: 20px 18px 16px 18px;
    align-items: center;
    background-color: var(--mm-slot-fill);
    background-image: url("Skin/Synty/SPR_FantasyMenus_Frame_Box_Small_01.png");
    -unity-background-image-tint-color: rgb(209, 205, 194);
    -unity-slice-scale: 0.22;
}

.ret-card--grew {
    background-color: rgb(8, 52, 44);
    -unity-background-image-tint-color: rgb(255, 232, 178);
}

.ret-card__icon {
    width: 100%;
    height: 150px;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(227, 187, 113, 0.4);
    background-color: var(--mm-bg-deep);
}

.ret-card--grew .ret-card__icon {
    border-color: var(--mm-gold);
}

.ret-card__name {
    width: 100%;
    margin-top: 8px;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 26px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    white-space: normal;
}

.ret-card__growth {
    width: 100%;
    min-height: 34px;
    margin-top: 8px;
    align-items: center;
    justify-content: center;
}

.ret-badge {
    padding: 2px 18px;
    min-height: 34px;
    background-image: url("Skin/Synty/SPR_FantasyMenus_Box_Small_Parchment_03.png");
    -unity-background-image-tint-color: var(--mm-gold);
    -unity-slice-scale: 0.35;
    color: var(--mm-ink-dark);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.ret-newpower {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
}

.ret-newpower__icon {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    margin-right: 8px;
    border-radius: 8px;
    background-color: var(--mm-bg-deep);
    -unity-background-scale-mode: scale-to-fit;
}

.ret-newpower__text {
    flex-shrink: 1;
    font-size: 18px;
    color: var(--mm-teal);
    white-space: normal;
}

.ret-pips {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.ret-pip {
    width: 20px;
    height: 20px;
    margin: 4px;
    border-radius: 10px;
    border-width: 2px;
    border-color: var(--mm-frame-soft);
    background-color: var(--mm-bg-deep);
}

.ret-pip--on {
    border-color: var(--mm-gold);
    background-color: var(--mm-gold);
}

.ret-note {
    margin-top: 6px;
    font-size: 20px;
    color: var(--mm-ink-soft);
    white-space: normal;
    -unity-text-align: middle-center;
}

.ret-columns {
    flex-direction: row;
    justify-content: center;
    margin-top: 14px;
}

.ret-col {
    width: 420px;
    min-height: 190px;
    margin: 0 16px;
}

.ret-col__title {
    -unity-text-align: middle-center;
    margin-top: 0;
}

.ret-line {
    min-height: 70px;
}

.ret-icon {
    width: 40px;
    height: 40px;
    -unity-background-scale-mode: scale-to-fit;
}

.ret-icon--gem {
    background-image: url("Skin/Synty/ICON_FantasyWarrior_Inventory_Minerals_01_Clean.png");
}

.ret-icon--rooms {
    background-image: url("Skin/Synty/ICON_FantasyWarrior_Status_Up_01_Clean.png");
}

.ret-minerita {
    margin-left: 14px;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 40px;
    color: var(--mm-teal);
}

.ret-rooms {
    margin-left: 14px;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 36px;
    color: var(--mm-section);
}

.ret-lost {
    margin-top: 6px;
    padding: 8px 26px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Small_Parchment_02.png");
    -unity-background-image-tint-color: rgb(150, 40, 30);
    -unity-slice-scale: 0.45;
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 24px;
    color: rgb(255, 255, 255);
    white-space: normal;
    -unity-text-align: middle-center;
}

.ret-actions {
    position: absolute;
    right: 70px;
    bottom: 50px;
}

.ret-continue {
    min-width: 300px;
}
