.grid-root {
    -unity-font-definition: url("Skin/Fonts/AlegreyaSans-Medium.ttf");
}

.grid-window {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 62px;
    padding: 24px 48px 18px 48px;
    flex-direction: row;
    align-items: stretch;
}

.grid-left {
    width: 640px;
    flex-shrink: 0;
}

.grid-right {
    width: 520px;
    flex-shrink: 0;
}

.grid-center {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.grid-core {
    flex-grow: 0;
    flex-shrink: 0;
    width: 340px;
    overflow: hidden;
}

.grid-portrait {
    width: 340px;
    height: 560px;
}

.grid-title {
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 26px 40px;
    height: 52px;
}

.grid-filters {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 6px;
}

.filter-button {
    min-height: 40px;
    padding: 0 16px;
    margin: 2px 6px 2px 0;
    font-size: 19px;
}

.grid-container {
    flex-grow: 1;
}

.grid-container .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    padding: 8px 4px 12px 4px;
}

.tile {
    width: 104px;
    height: 104px;
    margin: 5px;
    transition-property: scale, -unity-background-image-tint-color;
    transition-duration: 0.12s;
}

.tile:hover {
    -unity-background-image-tint-color: rgb(0, 70, 58);
}

.tile:hover .tile__frame {
    -unity-background-image-tint-color: rgb(250, 232, 190);
}

.tile--selected {
    -unity-background-image-tint-color: rgb(0, 96, 76);
}

.tile--selected .tile__frame {
    -unity-background-image-tint-color: rgb(227, 187, 113);
}

.tile__icon {
    width: 88px;
    height: 88px;
}

.tile__dot {
    position: absolute;
    right: 6px;
    top: 6px;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border-width: 2px;
    border-color: rgb(1, 14, 12);
}

.tile__dot--ready {
    background-color: var(--mm-good);
}

.tile__dot--blocked {
    background-color: var(--mm-warn);
}

.grid-empty {
    font-size: 22px;
    color: var(--mm-ink-soft);
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 12px 0;
}

.grid-count {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 20px;
    color: var(--mm-section);
    -unity-text-align: middle-right;
    margin-top: 6px;
}

.side-name {
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 26px 40px;
    height: 52px;
}

.side-spacer {
    flex-grow: 1;
}

.side-open {
    align-self: stretch;
}
