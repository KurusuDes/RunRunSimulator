.grid-root {
    -unity-font-definition: url("Skin/Fonts/AlegreyaSans-Medium.ttf");
}

.grid-window {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 62px;
    padding: 24px 48px 18px 48px;
}

.grid-panel {
    flex-grow: 1;
}

.grid-title {
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 28px 44px;
    height: 54px;
}

.grid-container {
    flex-grow: 1;
}

.grid-container .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-content: flex-start;
    padding: 10px 6px 16px 6px;
}

.card {
    margin: 12px;
    padding: 12px 10px 10px 10px;
    align-items: center;
    justify-content: flex-start;
    transition-property: scale, -unity-background-image-tint-color;
    transition-duration: 0.12s;
}

.card:hover {
    scale: 1.04 1.04;
    -unity-background-image-tint-color: rgb(0, 70, 58);
}

.card:hover .card__frame {
    -unity-background-image-tint-color: rgb(250, 232, 190);
}

.card--selected {
    -unity-background-image-tint-color: rgb(0, 96, 76);
}

.card--selected .card__frame {
    -unity-background-image-tint-color: rgb(227, 187, 113);
}

.card__name {
    width: 100%;
    flex-basis: 24%;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 15px 22px;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    white-space: normal;
    overflow: hidden;
}

.card--selected .card__name {
    color: var(--mm-section);
}

.card__icon {
    width: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    margin: 4px 0;
    border-radius: 8px;
    background-color: rgb(120, 120, 120);
}

.card__state {
    flex-shrink: 0;
    height: 34px;
    min-width: 76%;
    margin: 0;
    padding: 0 12px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Small_Parchment_02.png");
    -unity-background-image-tint-color: rgb(1, 14, 12);
    -unity-slice-scale: 0.45;
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 21px;
    color: var(--mm-teal);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
