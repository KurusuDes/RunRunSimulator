.exp {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.exp-window {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 62px;
    padding: 18px 56px 14px 56px;
}

.exp-head {
    align-items: center;
    flex-shrink: 0;
}

.exp-title {
    font-size: 52px;
}

.exp-subtitle {
    margin-top: 2px;
}

.exp-rule {
    width: 560px;
    align-self: center;
    margin: 8px 0 6px 0;
}

.exp-body {
    flex-direction: row;
    flex-shrink: 0;
    align-items: stretch;
    justify-content: center;
    height: 486px;
}

.exp-team-row {
    flex-direction: row;
    flex-shrink: 0;
    margin-right: 20px;
}

.exp-member {
    width: 300px;
    height: 470px;
    margin: 0 10px;
    padding: 18px 16px 14px 16px;
    align-items: center;
    flex-shrink: 0;
}

.exp-member:hover {
    scale: 1.02 1.02;
}

.exp-member--empty {
    justify-content: center;
    opacity: 0.6;
}

.exp-member--empty:hover {
    scale: 1 1;
}

.exp-member__runes {
    width: 160px;
    height: 160px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Tracery_Diamond_01.png");
    -unity-background-image-tint-color: rgba(227, 187, 113, 0.35);
    -unity-background-scale-mode: scale-to-fit;
}

.exp-member__hint {
    margin-top: 14px;
    width: 100%;
    font-size: 24px;
    color: var(--mm-ink-soft);
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    -unity-text-align: middle-center;
    white-space: normal;
}

.exp-member__stage {
    width: 100%;
    height: 200px;
    flex-shrink: 0;
    align-items: center;
    justify-content: flex-end;
}

.exp-member__floor {
    position: absolute;
    bottom: 10px;
    width: 220px;
    height: 56px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Circle_Background_01.png");
    -unity-background-image-tint-color: rgba(0, 10, 8, 0.55);
}

.exp-member__floor-ring {
    position: absolute;
    left: -6px;
    right: -6px;
    top: -3px;
    bottom: -3px;
    border-radius: 50%;
    border-width: 3px;
    border-color: rgba(227, 187, 113, 0.65);
}

.exp-member__portrait {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.exp-member__name {
    width: 100%;
    height: 40px;
    margin-top: 6px;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 18px 32px;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    white-space: normal;
}

.exp-member__role {
    align-self: center;
    margin-top: 4px;
}

.exp-member__role .mm-rolepill__seg {
    padding: 3px 14px;
    font-size: 18px;
}

.exp-member__role .mm-rolepill__seg--minor {
    padding: 3px 10px;
    font-size: 15px;
}

.exp-member__powers {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    margin-top: 14px;
    width: 100%;
}

.exp-power-col {
    width: 88px;
    align-items: center;
    margin: 0 2px;
}

.exp-power-col__title {
    width: 100%;
    margin-top: 6px;
    font-size: 16px;
    color: var(--mm-section);
    -unity-text-align: upper-center;
    white-space: normal;
}

.exp-power {
    width: 54px;
    height: 54px;
    border-width: 3px;
    border-radius: 10px;
    background-color: var(--mm-bg-deep);
    -unity-background-scale-mode: scale-to-fit;
}

.exp-power--locked {
    background-color: rgba(2, 20, 17, 0.85);
    border-color: var(--mm-frame-soft);
    justify-content: center;
    align-items: center;
}

.exp-power__lock {
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--mm-ink-soft);
}

.exp-side {
    width: 460px;
    flex-shrink: 0;
}

.exp-team {
    flex-grow: 1;
    flex-shrink: 1;
}

.exp-team__title {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 30px;
    color: var(--mm-section);
}

.exp-team__count {
    font-size: 26px;
    color: rgb(255, 255, 255);
    margin: 4px 0 14px 0;
}

.exp-team__pills {
    flex-direction: row;
    flex-wrap: wrap;
}

.exp-team__pill {
    margin: 0 8px 8px 0;
}

.exp-team__pill .mm-rolepill__seg {
    padding: 3px 12px;
    font-size: 16px;
}

.exp-team__pill .mm-rolepill__seg--minor {
    padding: 3px 9px;
    font-size: 14px;
}

.exp-team__warn {
    font-size: 19px;
    color: var(--mm-warn);
    white-space: normal;
    margin-top: 2px;
}

.exp-go {
    margin: 14px 0 0 0;
    flex-shrink: 0;
}

.exp-empty {
    margin: 6px 0 0 0;
    -unity-text-align: middle-center;
}

.exp-list {
    flex-shrink: 0;
    height: 218px;
    margin-top: 10px;
}

.exp-list .unity-scroll-view__content-container {
    flex-direction: row;
    justify-content: center;
    padding: 8px 4px;
}

.exp-list .unity-scroller--horizontal {
    height: 12px;
    margin-top: 4px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.exp-list .unity-scroller--horizontal .unity-scroller__low-button,
.exp-list .unity-scroller--horizontal .unity-scroller__high-button {
    display: none;
}

.exp-list .unity-scroller--horizontal .unity-base-slider__tracker {
    background-color: rgba(1, 14, 12, 0.9);
    border-width: 0;
    border-radius: 6px;
}

.exp-list .unity-scroller--horizontal .unity-base-slider__dragger {
    background-color: var(--mm-gold);
    border-width: 0;
    border-radius: 6px;
    top: 2px;
    bottom: 2px;
}

.exp-tile {
    width: 132px;
    margin: 0 8px;
    align-items: center;
    flex-shrink: 0;
    transition-property: scale;
    transition-duration: 140ms;
    transition-timing-function: ease-out;
}

.exp-tile__slot {
    width: 120px;
    height: 120px;
    border-width: 3px;
    border-color: rgba(227, 187, 113, 0.35);
    border-radius: 8px;
}

.exp-tile:hover {
    scale: 1.05 1.05;
}

.exp-tile--focus {
    scale: 1.08 1.08;
}

.exp-tile--focus .exp-tile__slot {
    border-color: rgb(255, 232, 178);
}

.exp-tile--on .exp-tile__slot {
    border-color: var(--mm-gold);
    border-width: 4px;
    background-color: rgb(0, 92, 72);
}

.exp-tile--off {
    opacity: 0.4;
}

.exp-tile__icon {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.exp-tile__name {
    width: 100%;
    height: 26px;
    margin-top: 6px;
    font-size: 20px;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.exp-tile__state {
    width: 100%;
    font-size: 16px;
    color: var(--mm-ink-soft);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.exp-tile__check {
    display: none;
    position: absolute;
    top: 4px;
    right: 4px;
    width: 30px;
    height: 30px;
    border-radius: 15px;
    border-width: 2px;
    border-color: var(--mm-bg-deep);
    background-color: var(--mm-gold);
    background-image: url("Skin/Synty/ICON_FantasyScreens_Menu_Done_01_Clean.png");
    -unity-background-image-tint-color: var(--mm-ink-dark);
    -unity-background-scale-mode: scale-to-fit;
    color: rgba(0, 0, 0, 0);
    font-size: 1px;
    padding: 0;
    margin: 0;
}

.exp-tile--on .exp-tile__check {
    display: flex;
}

.exp-tile__bar-track {
    width: 100px;
    height: 10px;
    margin-top: 4px;
    border-radius: 5px;
    background-color: rgb(1, 14, 12);
}

.exp-tile__bar-fill {
    height: 100%;
    border-radius: 5px;
}

.exp-bar--good { background-color: var(--mm-good); }
.exp-bar--warn { background-color: var(--mm-warn); }
.exp-bar--crit { background-color: var(--mm-crit); }

.exp-close {
    padding: 4px 12px 4px 62px;
    -unity-text-align: middle-left;
    font-size: 22px;
    -unity-font-style: normal;
    color: var(--mm-section);
}

.exp-close__key {
    position: absolute;
    left: 12px;
    top: 50%;
    margin-top: -16px;
}
