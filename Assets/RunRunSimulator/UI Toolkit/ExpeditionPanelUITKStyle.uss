.exp {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.exp-panel {
    width: 820px;
    max-width: 94%;
    max-height: 88%;
    border-width: 3px;
    border-color: var(--mm-frame);
    border-radius: 22px;
}

.exp-panel .panel__header {
    border-top-left-radius: 19px;
    border-top-right-radius: 19px;
}

.exp-subtitle {
    font-size: 14px;
    color: var(--mm-ink-soft);
    letter-spacing: 2px;
    margin: 14px 16px 6px 16px;
}

.exp-empty {
    font-size: 15px;
    color: var(--mm-ink-soft);
    margin: 24px 16px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.exp-list {
    min-height: 236px;
    max-height: 320px;
    margin: 0 10px;
}

.exp-list .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.exp-card {
    width: 150px;
    height: 220px;
    margin: 6px;
    padding: 5px;
    border-radius: 14px;
    background-color: var(--mm-surface-2);
    align-items: center;
    border-width: 3px;
    border-color: var(--mm-frame-soft);
    transition-property: scale, border-color, background-color;
    transition-duration: 140ms, 140ms, 140ms;
    transition-timing-function: ease-out, ease-out, ease-out;
}

.exp-card:hover {
    border-color: var(--mm-coral);
}

.exp-card--focus {
    border-color: var(--mm-coral);
    scale: 1.04 1.04;
}

.exp-card--on {
    border-color: var(--mm-ally);
    background-color: var(--mm-bg-deep);
}

.exp-card--on:hover {
    border-color: var(--mm-ally);
}

.exp-card--off {
    opacity: 0.45;
}

.exp-card__icon {
    height: 108px;
    width: 84%;
    border-radius: 8px;
    border-width: 2px;
    border-color: var(--mm-frame-soft);
    background-color: rgb(120, 120, 120);
}

.exp-card__name {
    height: 24px;
    width: 100%;
    margin-top: 2px;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 8px 20px;
    -unity-font-style: bold;
    color: var(--mm-ink);
    -unity-text-align: middle-center;
    white-space: normal;
}

.exp-card__state {
    height: 22px;
    width: 100%;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 8px 16px;
    color: var(--mm-gold);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.exp-card--off .exp-card__state {
    color: var(--mm-ink-soft);
    -unity-font-style: normal;
}

.exp-card__role {
    height: 20px;
    max-width: 100%;
    margin-top: 2px;
}

.exp-card__role .mm-rolepill__seg {
    padding: 0 8px;
}

.exp-card__role .mm-rolepill__seg--minor {
    padding: 0 7px;
}

.exp-card__powers {
    flex-direction: row;
    justify-content: center;
    margin-top: 6px;
}

.exp-power {
    width: 34px;
    height: 34px;
    margin: 0 3px;
    border-width: 3px;
    border-radius: 8px;
    background-color: var(--mm-bg-deep);
    -unity-background-scale-mode: scale-to-fit;
}

.exp-card__check {
    display: none;
    position: absolute;
    top: -7px;
    right: -7px;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--mm-bg-deep);
    background-color: var(--mm-ally);
    color: rgb(40, 26, 18);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

.exp-card--on .exp-card__check {
    display: flex;
}

.exp-card__bars {
    width: 92%;
    margin-top: 6px;
}

.exp-card__bar-track {
    width: 100%;
    height: 7px;
    margin-top: 3px;
    border-radius: 3px;
    background-color: var(--mm-bg-deep);
    border-width: 1px;
    border-color: var(--mm-frame-soft);
    overflow: hidden;
}

.exp-card__bar-track--weak {
    border-color: var(--mm-crit);
    border-width: 2px;
}

.exp-card__bar-fill {
    height: 100%;
    border-radius: 2px;
}

.exp-bar--good {
    background-color: var(--mm-good);
}

.exp-bar--warn {
    background-color: var(--mm-warn);
}

.exp-bar--crit {
    background-color: var(--mm-crit);
}

.exp-detail {
    height: 206px;
    margin: 8px 16px 0 16px;
    padding: 8px 14px;
    border-width: 2px;
    border-radius: 12px;
    border-color: var(--mm-frame-soft);
    background-color: var(--mm-bg-deep);
    overflow: hidden;
}

.exp-detail__head {
    flex-direction: row;
    align-items: center;
    height: 30px;
}

.exp-detail__name {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--mm-ink);
    margin-right: 10px;
    flex-shrink: 1;
    white-space: nowrap;
    overflow: hidden;
}

.exp-detail__role {
    flex-shrink: 0;
}

.exp-detail__row {
    flex-direction: row;
    align-items: center;
    height: 50px;
    margin-top: 2px;
}

.exp-detail__icon {
    width: 32px;
    height: 32px;
    margin-right: 10px;
    flex-shrink: 0;
    border-width: 2px;
    border-radius: 8px;
    background-color: var(--mm-surface-2);
    -unity-background-scale-mode: scale-to-fit;
}

.exp-detail__text {
    flex-grow: 1;
    flex-shrink: 1;
    height: 100%;
    justify-content: center;
    overflow: hidden;
}

.exp-detail__title {
    font-size: 15px;
    -unity-font-style: bold;
    white-space: nowrap;
}

.exp-detail__desc {
    font-size: 12px;
    color: var(--mm-ink-soft);
    white-space: normal;
}

.exp-team {
    height: 52px;
    margin: 6px 16px 0 16px;
}

.exp-team__row {
    flex-direction: row;
    align-items: center;
    height: 30px;
}

.exp-team__title {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--mm-ink-soft);
    margin-right: 10px;
}

.exp-team__pill {
    height: 22px;
    margin-right: 6px;
}

.exp-team__warn {
    height: 20px;
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--mm-warn);
    white-space: nowrap;
}

.exp-actions {
    padding-top: 6px;
}
