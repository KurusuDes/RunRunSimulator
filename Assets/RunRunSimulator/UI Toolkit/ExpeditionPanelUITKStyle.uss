.exp {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.exp-window {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 62px;
    padding: 22px 56px 20px 56px;
}

.exp-head {
    align-items: center;
    flex-shrink: 0;
}

.exp-title {
    font-size: 52px;
}

.exp-subtitle {
    margin-top: 2px;
}

.exp-rule {
    width: 560px;
    align-self: center;
    margin: 10px 0 8px 0;
}

.exp-body {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    align-items: stretch;
    min-height: 0;
}

.exp-list {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 24px;
}

.exp-list .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: center;
    padding: 8px 4px;
}

.exp-list .unity-scroller--vertical {
    width: 12px;
    margin-left: 6px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.exp-list .unity-scroller--vertical .unity-scroller__low-button,
.exp-list .unity-scroller--vertical .unity-scroller__high-button {
    display: none;
}

.exp-list .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(1, 14, 12, 0.9);
    border-width: 0;
    border-radius: 6px;
}

.exp-list .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: var(--mm-gold);
    border-width: 0;
    border-radius: 6px;
    left: 2px;
    right: 2px;
}

.exp-list .unity-scroller--vertical .unity-base-slider__drag-container {
    top: 0;
    bottom: 0;
}

.exp-card {
    width: 262px;
    height: 372px;
    margin: 10px;
    padding: 24px 22px 18px 22px;
    align-items: center;
    background-color: var(--mm-slot-fill);
    background-image: url("Skin/Synty/SPR_FantasyMenus_Frame_Box_Small_01.png");
    -unity-background-image-tint-color: rgb(209, 205, 194);
    -unity-slice-scale: 0.22;
    transition-property: scale, background-color, -unity-background-image-tint-color;
    transition-duration: 140ms, 140ms, 140ms;
    transition-timing-function: ease-out, ease-out, ease-out;
}

.exp-card:hover {
    -unity-background-image-tint-color: rgb(255, 232, 178);
}

.exp-card--focus {
    background-color: rgb(8, 52, 44);
    -unity-background-image-tint-color: rgb(255, 232, 178);
    scale: 1.04 1.04;
}

.exp-card--on {
    background-color: rgb(0, 92, 72);
    -unity-background-image-tint-color: rgb(120, 240, 200);
}

.exp-card--on:hover {
    -unity-background-image-tint-color: rgb(150, 255, 214);
}

.exp-card--off {
    opacity: 0.5;
}

.exp-card__icon {
    width: 100%;
    height: 176px;
    flex-shrink: 0;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(227, 187, 113, 0.4);
    background-color: rgb(40, 60, 56);
}

.exp-card__name {
    height: 40px;
    width: 100%;
    margin-top: 6px;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 16px 30px;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    white-space: normal;
}

.exp-card__state {
    height: 30px;
    width: 100%;
    margin-top: 4px;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 14px 24px;
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    color: var(--mm-section);
    -unity-text-align: middle-center;
    white-space: normal;
}

.exp-card--off .exp-card__state {
    color: var(--mm-ink-soft);
}

.exp-card__role {
    align-self: center;
    margin-top: 4px;
}

.exp-card__role .mm-rolepill__seg {
    padding: 3px 14px;
    font-size: 18px;
}

.exp-card__role .mm-rolepill__seg--minor {
    padding: 3px 10px;
    font-size: 15px;
}

.exp-card__powers {
    flex-direction: row;
    justify-content: center;
    margin-top: 12px;
}

.exp-power {
    width: 54px;
    height: 54px;
    margin: 0 5px;
    border-width: 3px;
    border-radius: 10px;
    background-color: var(--mm-bg-deep);
    -unity-background-scale-mode: scale-to-fit;
}

.exp-power--locked {
    background-color: rgba(2, 20, 17, 0.85);
    border-color: var(--mm-frame-soft);
    justify-content: center;
    align-items: center;
}

.exp-power__lock {
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--mm-ink-soft);
}

.exp-card__check {
    display: none;
    position: absolute;
    top: 10px;
    right: 10px;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    border-width: 2px;
    border-color: var(--mm-bg-deep);
    background-color: var(--mm-gold);
    background-image: url("Skin/Synty/ICON_FantasyScreens_Menu_Done_01_Clean.png");
    -unity-background-image-tint-color: var(--mm-ink-dark);
    -unity-background-scale-mode: scale-to-fit;
    color: rgba(0, 0, 0, 0);
    font-size: 1px;
    padding: 0;
    margin: 0;
}

.exp-card--on .exp-card__check {
    display: flex;
}

.exp-card__bars {
    width: 100%;
    margin-top: 14px;
}

.exp-card__bar-track {
    width: 100%;
    height: 22px;
    background-image: url("Skin/Synty/SPR_FantasyMenus_Box_Small_Parchment_01.png");
    -unity-background-image-tint-color: rgb(1, 14, 12);
    -unity-slice-scale: 0.15;
    padding: 3px;
}

.exp-card__bar-fill {
    height: 100%;
    border-radius: 5px;
}

.exp-bar--good { background-color: var(--mm-good); }
.exp-bar--warn { background-color: var(--mm-warn); }
.exp-bar--crit { background-color: var(--mm-crit); }

.exp-side {
    width: 600px;
    flex-shrink: 0;
}

.exp-empty {
    margin: 4px 0 12px 0;
    -unity-text-align: middle-center;
}

.exp-detail {
    flex-grow: 1;
    flex-shrink: 1;
}

.exp-detail__head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
}

.exp-detail__name {
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 34px;
    color: rgb(255, 255, 255);
    margin-right: 12px;
    flex-shrink: 1;
    white-space: nowrap;
    overflow: hidden;
}

.exp-detail__role {
    flex-shrink: 0;
}

.exp-detail__role .mm-rolepill__seg {
    padding: 4px 14px;
    font-size: 18px;
}

.exp-detail__role .mm-rolepill__seg--minor {
    padding: 4px 10px;
    font-size: 15px;
}

.exp-detail__row {
    flex-direction: row;
    align-items: center;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Medium_Parchment02.png");
    -unity-background-image-tint-color: var(--mm-row-fill);
    -unity-slice-scale: 0.22;
    min-height: 92px;
    padding: 10px 14px;
    margin-bottom: 8px;
}

.exp-detail__icon {
    width: 58px;
    height: 58px;
    margin-right: 14px;
    flex-shrink: 0;
    border-width: 3px;
    border-radius: 10px;
    background-color: var(--mm-bg-deep);
    -unity-background-scale-mode: scale-to-fit;
}

.exp-detail__text {
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: center;
}

.exp-detail__title {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 24px;
    white-space: nowrap;
}

.exp-detail__desc {
    font-size: 18px;
    color: var(--mm-ink-soft);
    white-space: normal;
}

.exp-team {
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Medium_Parchment02.png");
    -unity-background-image-tint-color: var(--mm-row-fill);
    -unity-slice-scale: 0.22;
    min-height: 66px;
    padding: 10px 16px;
    margin-top: 4px;
    justify-content: center;
    flex-shrink: 0;
}

.exp-team__row {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
}

.exp-team__title {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 22px;
    color: var(--mm-section);
    margin-right: 14px;
}

.exp-team__pill {
    margin-right: 8px;
}

.exp-team__pill .mm-rolepill__seg {
    padding: 3px 12px;
    font-size: 16px;
}

.exp-team__pill .mm-rolepill__seg--minor {
    padding: 3px 9px;
    font-size: 14px;
}

.exp-team__warn {
    font-size: 19px;
    color: var(--mm-warn);
    white-space: normal;
    margin-top: 2px;
}

.exp-go {
    margin: 14px 0 0 0;
    flex-shrink: 0;
}

.exp-close {
    padding: 4px 12px 4px 62px;
    -unity-text-align: middle-left;
    font-size: 22px;
    -unity-font-style: normal;
    color: var(--mm-section);
}

.exp-close__key {
    position: absolute;
    left: 12px;
    top: 50%;
    margin-top: -16px;
}
