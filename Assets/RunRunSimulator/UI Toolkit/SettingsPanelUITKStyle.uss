.set-root {
    align-items: center;
    justify-content: center;
}

.set-panel {
    width: 1440px;
    max-width: 96%;
    height: 900px;
    max-height: 94%;
    flex-shrink: 1;
}

.set-title {
    font-size: 48px;
    margin: 0;
}

.set-panel > .mm-bar {
    margin: 8px 0 12px 0;
}

.set-nav {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    margin: 0 0 14px 0;
}

.set-tab {
    min-width: 200px;
    height: 62px;
    margin: 0 6px 6px 6px;
    padding: 0 36px;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Menu_Tab_01_Background.png");
    -unity-background-image-tint-color: var(--mm-tab-fill);
    -unity-slice-scale: 0.3;
    -unity-text-align: middle-center;
    font-size: 24px;
    letter-spacing: 2px;
    color: var(--mm-ink-soft);
    transition-property: -unity-background-image-tint-color, color;
    transition-duration: 0.12s;
}

.set-tab:hover {
    color: rgb(255, 255, 255);
    -unity-background-image-tint-color: rgb(8, 92, 74);
}

.set-tab--active,
.set-tab--active:hover {
    color: rgb(255, 255, 255);
    -unity-background-image-tint-color: var(--mm-tab-fill-on);
}

.set-body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.set-content {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 6px 0 0 0;
}

.set-content .unity-scroll-view__content-container {
    padding: 0 10px 0 0;
}

.set-header {
    background-image: url("Skin/Synty/SPR_FantasyMenus_Menu_Button_06_Frame.png");
    -unity-slice-scale: 0.22;
    -unity-text-align: middle-center;
    align-self: center;
    min-width: 300px;
    height: 46px;
    margin: 4px 0 16px 0;
    padding: 0 60px;
    font-size: 28px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
}

.set-note {
    background-image: url("Skin/Synty/SPR_FantasyMenus_Box_Small_Parchment_01.png");
    -unity-background-image-tint-color: rgba(92, 60, 12, 0.7);
    -unity-slice-scale: 0.3;
    padding: 14px 28px;
    margin: 0 0 14px 0;
    font-size: 20px;
    color: var(--mm-warn);
    -unity-text-align: middle-center;
    white-space: normal;
}

.set-row {
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Medium_Parchment02.png");
    -unity-background-image-tint-color: var(--mm-row-fill);
    -unity-slice-scale: 0.22;
    flex-direction: row;
    align-items: center;
    min-height: 68px;
    padding: 8px 18px 8px 24px;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.set-row__label {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
    padding: 0;
    font-size: 23px;
    color: var(--mm-ink);
    white-space: normal;
}

.set-row__control {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    width: 580px;
    flex-shrink: 0;
}

.set-row__value {
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Small_Parchment_02.png");
    -unity-background-image-tint-color: rgb(1, 14, 12);
    -unity-slice-scale: 0.45;
    width: 104px;
    min-height: 44px;
    margin: 0 0 0 14px;
    padding: 2px 10px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    font-size: 21px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.set-dropdown {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
    padding: 0;
    min-height: 48px;
}

.set-dropdown .unity-base-popup-field__input {
    min-height: 48px;
    margin: 0;
    padding: 0 18px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Small_Parchment_02.png");
    -unity-background-image-tint-color: rgb(1, 14, 12);
    -unity-slice-scale: 0.45;
    border-width: 0;
    border-radius: 0;
    align-items: center;
}

.set-dropdown:hover .unity-base-popup-field__input,
.set-dropdown:focus .unity-base-popup-field__input {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(6, 38, 33);
    border-width: 0;
}

.set-dropdown .unity-base-popup-field__text {
    margin: 0;
    padding: 0;
    font-size: 22px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-left;
}

.set-dropdown .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--mm-gold);
    width: 22px;
    height: 22px;
}

.set-slider {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
    padding: 0;
    min-height: 48px;
}

.set-slider .unity-base-slider__input {
    flex-grow: 1;
    height: 48px;
    margin: 0;
    padding: 0;
}

.set-slider .unity-base-slider__input .unity-base-slider__drag-container {
    position: relative;
    flex-grow: 1;
    height: 48px;
    margin: 0;
    padding: 0;
}

.set-slider .unity-base-slider__input .unity-base-slider__drag-container .unity-base-slider__tracker {
    position: absolute;
    left: 0;
    right: 0;
    top: 17px;
    height: 14px;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Skin/Synty/SPR_FantasyWarrior_Bar_Horizontal_04.png");
    -unity-slice-scale: 0.5;
    border-width: 0;
    border-radius: 0;
}

.set-slider .unity-base-slider__input .unity-base-slider__drag-container .unity-base-slider__dragger {
    position: absolute;
    top: 4px;
    width: 40px;
    height: 40px;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Skin/Synty/SPR_FantasyWarrior_Gem_09.png");
    -unity-background-scale-mode: scale-to-fit;
    border-width: 0;
    border-radius: 0;
    transition-property: scale;
    transition-duration: 0.12s;
}

.set-slider .unity-base-slider__input .unity-base-slider__drag-container .unity-base-slider__dragger:hover {
    background-color: rgba(0, 0, 0, 0);
    scale: 1.12 1.12;
}

.set-slider .unity-base-slider__input .unity-base-slider__drag-container .unity-base-slider__dragger-border {
    display: none;
}

.set-slider:focus .unity-base-slider__input .unity-base-slider__drag-container .unity-base-slider__dragger {
    background-color: rgba(0, 0, 0, 0);
}

.set-toggle {
    margin: 0;
    padding: 0;
}

.set-toggle .unity-toggle__input {
    width: 52px;
    height: 52px;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Small_Parchment_02.png");
    -unity-background-image-tint-color: rgb(1, 14, 12);
    -unity-slice-scale: 0.45;
    border-width: 0;
    border-radius: 0;
}

.set-toggle:hover .unity-toggle__input,
.set-toggle:focus .unity-toggle__input {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(6, 38, 33);
    border-width: 0;
}

.set-toggle .unity-toggle__input .unity-toggle__checkmark {
    width: 36px;
    height: 36px;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-width: 0;
    border-radius: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--mm-gold);
}

.set-toggle:checked > .unity-toggle__input > .unity-toggle__checkmark {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Skin/Synty/ICON_FantasyScreens_Menu_Done_01_Clean.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--mm-gold);
}

.unity-base-dropdown__container-outer {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Small_Parchment_02.png");
    -unity-background-image-tint-color: rgb(3, 26, 22);
    -unity-slice-scale: 0.5;
    border-width: 0;
    border-radius: 0;
    padding: 18px 16px;
    -unity-font-definition: url("Skin/Fonts/AlegreyaSans-Medium.ttf");
}

.unity-base-dropdown__container-inner {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.unity-base-dropdown__item {
    min-height: 46px;
    margin: 2px 0;
    padding: 0 18px;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    align-items: center;
}

.unity-base-dropdown__item:hover,
.unity-base-dropdown__item:focus {
    background-color: rgba(64, 196, 164, 0.28);
}

.unity-base-dropdown__label {
    font-size: 22px;
    color: rgb(245, 240, 230);
    -unity-font-definition: url("Skin/Fonts/AlegreyaSans-Medium.ttf");
    -unity-text-align: middle-left;
}

.unity-base-dropdown__item:hover .unity-base-dropdown__label,
.unity-base-dropdown__item:focus .unity-base-dropdown__label {
    color: rgb(255, 255, 255);
}

.unity-base-dropdown__checkmark {
    -unity-background-image-tint-color: rgb(227, 187, 113);
}

.set-footer {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
    margin-top: 12px;
}

.set-status {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
    padding: 0 0 0 6px;
    -unity-text-align: middle-left;
}

.set-button {
    min-width: 210px;
    min-height: 56px;
    margin: 0 0 0 12px;
    font-size: 22px;
}
