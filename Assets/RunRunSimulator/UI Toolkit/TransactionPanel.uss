.panel {
    width: 640px;
    max-width: 92%;
    background-color: var(--mm-surface);
    border-width: 2px;
    border-color: var(--mm-plum);
    border-radius: 16px;
}

.panel__header {
    background-color: var(--mm-surface-2);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    padding: 10px 16px;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: var(--mm-frame-soft);
}

.panel__title {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--mm-gold);
    letter-spacing: 4px;
}

.actions { flex-direction: row; padding: 0 16px 18px 16px; }

.action {
    flex-grow: 1;
    flex-basis: 0;
    height: 42px;
    margin-right: 10px;
    border-radius: 10px;
    border-width: 0;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(245, 245, 248);
}

.action--more { margin-right: 0; }

.action--cancel { background-color: var(--mm-crit); }
.action--cancel:hover { background-color: var(--mm-crit); }
.action--accept { background-color: var(--mm-good); }
.action--accept:hover { background-color: var(--mm-good); }
.action--more { background-color: var(--mm-gold); }
.action--more:hover { background-color: var(--mm-gold); }

.action:disabled { opacity: 0.40; }

.tx-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(3, 14, 12, 0.72);
}

.tx-panel {
    width: 1000px;
    max-width: 96%;
}

.tx-panel .panel__title {
    -unity-font-style: normal;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 48px;
    letter-spacing: 3px;
    color: rgb(255, 255, 255);
}

.tx-body {
    flex-direction: row;
    align-items: stretch;
    padding: 6px 0 14px 0;
}

.tx-col {
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
}

.tx-col--wide {
    flex-grow: 1.15;
}

.tx-divider {
    width: 2px;
    margin: 10px 18px;
    background-color: rgba(227, 187, 113, 0.35);
}

.col__label {
    -unity-text-align: middle-center;
    margin: 0 0 14px 0;
}

.tx-avatar {
    width: 180px;
    height: 180px;
    background-image: url("Skin/Synty/SPR_FantasyMenus_Ring_Medium_01.png");
    -unity-background-image-tint-color: var(--mm-gold);
    align-items: center;
    justify-content: center;
}

.tx-avatar__icon {
    width: 92px;
    height: 92px;
    background-image: url("Skin/Synty/ICON_FantasyScreens_Character_Head_01_Clean.png");
    -unity-background-image-tint-color: var(--mm-ink-soft);
    -unity-background-scale-mode: scale-to-fit;
}

.customer-name {
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 32px;
    color: rgb(255, 255, 255);
    margin-top: 14px;
    -unity-text-align: middle-center;
}

.archetype {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 24px;
    color: var(--mm-teal);
    margin-top: 4px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.tx-portrait {
    width: 200px;
    height: 200px;
    margin: 6px 0 4px 0;
}

.tx-portrait .mm-slot__frame {
    -unity-slice-scale: 0.4;
}

.mm-portrait {
    position: absolute;
    left: 10px;
    right: 10px;
    top: 10px;
    bottom: 10px;
}

.tx-runes {
    position: absolute;
    left: 40px;
    right: 40px;
    top: 40px;
    bottom: 40px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Tracery_Diamond_01.png");
    -unity-background-image-tint-color: rgba(227, 187, 113, 0.35);
    -unity-background-scale-mode: scale-to-fit;
}

.target-name {
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 32px;
    color: rgb(255, 255, 255);
    margin-top: 12px;
    -unity-text-align: middle-center;
}

.target-info {
    font-size: 22px;
    color: var(--mm-ink-soft);
    margin-top: 2px;
    -unity-text-align: middle-center;
}

.tx-price {
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Box_Small_Parchment_02.png");
    -unity-background-image-tint-color: rgb(1, 14, 12);
    -unity-slice-scale: 0.45;
    width: 250px;
    min-height: 220px;
    margin-top: 6px;
    padding: 20px 16px;
    align-items: center;
    justify-content: center;
}

.tx-coin {
    width: 72px;
    height: 72px;
    background-image: url("Skin/Synty/ICON_SM_Item_Coins_02_Dungeon.png");
    -unity-background-scale-mode: scale-to-fit;
}

.offer {
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 60px;
    color: var(--mm-section);
    margin-top: 8px;
    -unity-text-align: middle-center;
}

.offer-unit {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 22px;
    color: var(--mm-ink-soft);
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.tx-actions {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding-top: 4px;
}

.tx-btn {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 60px;
    margin: 4px 8px;
}

.tx-btn--accept {
    flex-grow: 1.3;
}

.tx-btn--counter {
    -unity-background-image-tint-color: rgb(20, 130, 106);
    color: rgb(255, 255, 255);
}

.tx-btn--counter:hover {
    -unity-background-image-tint-color: rgb(36, 168, 138);
}

.tx-btn--reject {
    -unity-background-image-tint-color: rgb(150, 52, 40);
    color: rgb(255, 255, 255);
}

.tx-btn--reject:hover {
    -unity-background-image-tint-color: rgb(196, 70, 52);
}
