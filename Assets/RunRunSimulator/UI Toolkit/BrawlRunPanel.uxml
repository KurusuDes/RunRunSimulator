<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Theme.uss" />
    <Style src="BrawlRunPanelStyle.uss" />
    <ui:VisualElement name="run-root" class="mm-theme mm-theme--night mm-hud run" picking-mode="Ignore">
        <ui:VisualElement name="run-hud" class="run-hud" picking-mode="Ignore">
            <ui:VisualElement name="run-bag" class="run-bag" picking-mode="Ignore">
                <ui:VisualElement class="run-bag__icon" picking-mode="Ignore" />
                <ui:Label name="run-bag-count" text="0" class="run-bag__count" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="run-left" class="run-left" picking-mode="Ignore">
                <ui:VisualElement class="run-left__pill" picking-mode="Ignore">
                    <ui:VisualElement name="run-left-pips" class="run-pips" picking-mode="Ignore" />
                    <ui:Label name="run-left-text" text="" class="run-left__text" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="run-trial" text="" class="run-trial" picking-mode="Ignore" />
            <ui:VisualElement name="run-loot" class="run-loot" picking-mode="Ignore">
                <ui:VisualElement name="run-gem-1" class="run-loot__gem" picking-mode="Ignore" />
                <ui:VisualElement name="run-gem-2" class="run-loot__gem" picking-mode="Ignore" />
                <ui:VisualElement name="run-gem-3" class="run-loot__gem" picking-mode="Ignore" />
                <ui:VisualElement name="run-gem-4" class="run-loot__gem" picking-mode="Ignore" />
                <ui:VisualElement name="run-gem-5" class="run-loot__gem" picking-mode="Ignore" />
                <ui:VisualElement name="run-gem-6" class="run-loot__gem" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="run-card-wrap" class="run-card-wrap" picking-mode="Ignore">
            <ui:VisualElement name="run-card" class="mm-skin mm-panel mm-panel--compact run-card">
                <ui:VisualElement class="mm-layer mm-panel__lip" picking-mode="Ignore" />
                <ui:VisualElement class="mm-layer mm-panel__frame" picking-mode="Ignore" />
                <ui:Label name="run-title" text="" class="mm-title run-title" picking-mode="Ignore" />
                <ui:VisualElement name="run-rooms" class="run-rooms" picking-mode="Ignore" />
                <ui:VisualElement name="run-team" class="run-team" picking-mode="Ignore" />
                <ui:Label name="run-info" text="" class="run-info" picking-mode="Ignore" />
                <ui:VisualElement class="run-buttons" picking-mode="Ignore">
                    <ui:Button name="run-go" text="" focusable="false" class="mm-button mm-button--big run-btn" />
                    <ui:Button name="run-leave" text="" focusable="false" class="mm-button mm-button--alt run-btn" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="run-veil" class="run-veil" picking-mode="Ignore">
            <ui:VisualElement class="run-veil__vignette" picking-mode="Ignore" />
            <ui:VisualElement name="run-veil-glyph" class="run-veil__glyph" picking-mode="Ignore" />
            <ui:VisualElement class="run-veil__line" picking-mode="Ignore">
                <ui:VisualElement class="run-veil__half run-veil__half--l" picking-mode="Ignore" />
                <ui:VisualElement class="run-veil__half run-veil__half--r" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="run-veil-title" text="" class="run-veil__title" picking-mode="Ignore" />
            <ui:VisualElement class="run-veil__line run-veil__line--bottom" picking-mode="Ignore">
                <ui:VisualElement class="run-veil__half run-veil__half--l" picking-mode="Ignore" />
                <ui:VisualElement class="run-veil__half run-veil__half--r" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="run-veil-pips" class="run-pips run-pips--big" picking-mode="Ignore" />
            <ui:Label name="run-veil-left" text="" class="run-veil__left" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
