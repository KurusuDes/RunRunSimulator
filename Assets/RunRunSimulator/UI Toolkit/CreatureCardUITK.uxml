<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="CreatureGridUITKStyle.uss" />
    <ui:VisualElement name="card" class="card mm-slot">
        <ui:VisualElement class="mm-layer mm-slot__vignette" picking-mode="Ignore" />
        <ui:Label name="name-label" text="Name" class="card__name" picking-mode="Ignore" />
        <ui:VisualElement name="icon" class="card__icon" picking-mode="Ignore" />
        <ui:Label name="state-label" text="Free" class="card__state" picking-mode="Ignore" />
        <ui:VisualElement class="mm-layer mm-slot__frame card__frame" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
