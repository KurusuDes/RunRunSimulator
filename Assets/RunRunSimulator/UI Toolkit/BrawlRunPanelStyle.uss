.run {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.run-bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 10px;
    background-color: var(--mm-surface);
    opacity: 0.82;
}

.run-hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.run-bag {
    position: absolute;
    bottom: 28px;
    right: 32px;
    flex-direction: row;
    align-items: center;
    padding: 8px 16px 8px 10px;
    border-radius: 16px;
    border-width: 2px;
    border-color: rgba(51, 191, 166, 0.4);
    background-color: rgba(14, 10, 9, 0.78);
}

.run-bag__icon {
    width: 40px;
    height: 40px;
    background-image: resource("Sprites/Brawl/RoomGlyph_Mineral");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--mm-teal);
}

.run-bag__count {
    margin-left: 8px;
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--mm-teal);
}

.run-left {
    position: absolute;
    left: 0;
    right: 0;
    top: 118px;
    align-items: center;
}

.run-left__text {
    margin-top: 6px;
    font-size: 15px;
    color: var(--mm-ink);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

.run-pips {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.run-pip {
    width: 12px;
    height: 12px;
    margin: 0 3px;
    border-radius: 6px;
    border-width: 2px;
}

.run-pip--done {
    background-color: var(--mm-teal);
    border-color: var(--mm-teal);
}

.run-pip--current {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background-color: var(--mm-gold);
    border-color: var(--mm-gold);
}

.run-pip--upcoming {
    border-color: var(--mm-frame-soft);
}

.run-pips--big .run-pip {
    width: 24px;
    height: 24px;
    margin: 0 6px;
    border-radius: 12px;
    border-width: 4px;
}

.run-pips--big .run-pip--current {
    width: 32px;
    height: 32px;
    border-radius: 16px;
}

.run-trial {
    position: absolute;
    left: 50%;
    top: 174px;
    translate: -50% 0;
    padding: 4px 12px;
    border-radius: 10px;
    background-color: rgba(14, 10, 9, 0.78);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--mm-ink);
}

.run-loot {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.run-loot__gem {
    position: absolute;
    left: 50%;
    top: 45%;
    width: 44px;
    height: 44px;
    margin-left: -22px;
    margin-top: -22px;
    opacity: 0;
    background-image: resource("Sprites/Brawl/RoomGlyph_Mineral");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--mm-teal);
}

.run-veil {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    opacity: 0;
    background-color: rgba(10, 7, 6, 0.94);
}

.run-veil__glyph {
    width: 168px;
    height: 168px;
    margin-bottom: 14px;
    -unity-background-scale-mode: scale-to-fit;
}

.run-veil__title {
    margin-bottom: 14px;
    font-size: 40px;
    -unity-font-style: bold;
    color: var(--mm-ink);
}

.run-veil .run-pips {
    margin-bottom: 14px;
}

.run-veil__left {
    font-size: 18px;
    color: var(--mm-ink-soft);
}

.run-rooms {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 10px;
}

.run-room {
    width: 72px;
    height: 72px;
    margin: 0 5px;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--mm-frame-soft);
    background-color: rgba(14, 10, 9, 0.6);
}

.run-room--current {
    border-width: 3px;
    border-color: var(--mm-gold);
}

.run-room--done {
    opacity: 0.35;
}

.run-room__glyph {
    width: 52px;
    height: 52px;
    -unity-background-scale-mode: scale-to-fit;
}

.run-glyph--foe {
    -unity-background-image-tint-color: var(--mm-foe);
}

.run-glyph--heal {
    -unity-background-image-tint-color: var(--mm-good);
}

.run-glyph--mineral {
    -unity-background-image-tint-color: var(--mm-teal);
}

.run-card-wrap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 24px;
    align-items: center;
}

.run-card {
    width: 560px;
    max-width: 90%;
    align-items: center;
    padding: 14px 20px 16px 20px;
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--mm-frame);
}

.run-card > .run-bg {
    border-radius: 12px;
    opacity: 0.94;
}

.run-title {
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--mm-ink);
}

.run-minerita {
    max-width: 100%;
    margin-top: 10px;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    white-space: normal;
    color: var(--mm-teal);
}

.run-info {
    max-width: 100%;
    margin-top: 6px;
    font-size: 15px;
    -unity-text-align: upper-center;
    white-space: normal;
    color: var(--mm-ink-soft);
}

.run-buttons {
    flex-direction: row;
    justify-content: center;
    margin-top: 14px;
}

.run-btn {
    height: 46px;
    min-width: 200px;
    margin: 0 8px;
    padding: 0 22px;
    border-radius: 10px;
    border-width: 2px;
    border-color: var(--mm-frame-soft);
    background-color: var(--mm-surface);
    color: var(--mm-ink);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.run-btn:hover {
    border-color: var(--mm-frame);
}

.run-btn--go {
    border-color: var(--mm-gold);
    color: var(--mm-gold);
}

.run-btn--go:hover {
    border-color: var(--mm-ink);
}
