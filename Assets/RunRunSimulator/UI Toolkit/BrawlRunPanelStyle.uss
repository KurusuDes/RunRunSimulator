.run {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.run-hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.run-bag {
    position: absolute;
    bottom: 28px;
    right: 32px;
    flex-direction: row;
    align-items: center;
    padding: 6px 24px 6px 18px;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Bar_Rounded_01.png");
    -unity-background-image-tint-color: var(--hud-pill);
    -unity-slice-scale: 0.4;
}

.run-bag__icon {
    width: 40px;
    height: 40px;
    background-image: url("Skin/Synty/ICON_SM_Item_Crystal_02.png");
    -unity-background-scale-mode: scale-to-fit;
}

.run-bag__count {
    margin-left: 10px;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 34px;
    color: rgb(255, 255, 255);
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.6);
}

.run-left {
    position: absolute;
    left: 0;
    right: 0;
    top: 118px;
    align-items: center;
}

.run-left__pill {
    align-items: center;
    padding: 8px 22px 8px 22px;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Box_Rounded_Medium_02.png");
    -unity-background-image-tint-color: var(--hud-pill);
    -unity-slice-scale: 0.2;
}

.run-left__text {
    margin-top: 4px;
    font-size: 18px;
    color: rgb(255, 255, 255);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
}

.run-pips {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.run-pip {
    width: 12px;
    height: 12px;
    margin: 0 3px;
    border-radius: 6px;
    border-width: 2px;
}

.run-pip--done {
    background-color: rgb(168, 124, 66);
    border-color: rgb(168, 124, 66);
}

.run-pip--current {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background-color: var(--hud-gold);
    border-color: var(--hud-gold);
}

.run-pip--upcoming {
    background-color: rgba(17, 14, 12, 0.7);
    border-color: rgb(99, 75, 49);
}

.run-pips--big .run-pip {
    width: 24px;
    height: 24px;
    margin: 0 6px;
    border-radius: 12px;
    border-width: 4px;
}

.run-pips--big .run-pip--current {
    width: 32px;
    height: 32px;
    border-radius: 16px;
}

.run-trial {
    position: absolute;
    left: 50%;
    top: 174px;
    translate: -50% 0;
    padding: 8px 22px;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Box_Rounded_Medium_02.png");
    -unity-background-image-tint-color: var(--hud-pill);
    -unity-slice-scale: 0.2;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 19px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
}

.run-loot {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.run-loot__gem {
    position: absolute;
    left: 50%;
    top: 45%;
    width: 44px;
    height: 44px;
    margin-left: -22px;
    margin-top: -22px;
    opacity: 0;
    background-image: url("Skin/Synty/ICON_SM_Item_Crystal_02.png");
    -unity-background-scale-mode: scale-to-fit;
}

.run-veil {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    opacity: 0;
    background-color: rgba(10, 7, 6, 0.94);
}

.run-veil__glyph {
    width: 168px;
    height: 168px;
    margin-bottom: 14px;
    -unity-background-scale-mode: scale-to-fit;
}

.run-veil__title {
    margin-bottom: 18px;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 64px;
    color: rgb(255, 255, 255);
    text-shadow: 0 4px 6px rgba(0, 0, 0, 0.75);
}

.run-veil .run-pips {
    margin-bottom: 16px;
}

.run-veil__left {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 26px;
    color: var(--hud-gold);
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.7);
}

.run-rooms {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 14px;
}

.run-room {
    width: 72px;
    height: 72px;
    margin: 0 6px;
    align-items: center;
    justify-content: center;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Box_Rounded_Medium_01.png");
    -unity-background-image-tint-color: var(--hud-slot);
    -unity-slice-scale: 0.2;
}

.run-room--current {
    -unity-background-image-tint-color: var(--hud-slot-active);
    scale: 1.08 1.08;
}

.run-room--done {
    opacity: 0.35;
}

.run-room__runes {
    position: absolute;
    left: 6px;
    top: 6px;
    right: 6px;
    bottom: 6px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Tracery_Diamond_01.png");
    -unity-background-image-tint-color: rgba(36, 32, 26, 0.6);
}

.run-room__frame {
    position: absolute;
    left: -5px;
    top: -1px;
    right: -5px;
    bottom: -9px;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Frame_Rounded_02.png");
    -unity-background-image-tint-color: var(--hud-gold);
    -unity-slice-scale: 0.25;
    opacity: 0;
}

.run-room--current .run-room__frame {
    opacity: 1;
}

.run-room__glyph {
    width: 52px;
    height: 52px;
    -unity-background-scale-mode: scale-to-fit;
}

.run-glyph--foe {
    -unity-background-image-tint-color: var(--mm-foe);
}

.run-glyph--heal {
    -unity-background-image-tint-color: var(--mm-good);
}

.run-glyph--mineral {
    -unity-background-image-tint-color: var(--mm-teal);
}

.run-card-wrap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 24px;
    align-items: center;
}

.run-card {
    width: 620px;
    max-width: 90%;
    align-items: center;
}

.run-title {
    font-size: 34px;
}

.run-minerita {
    max-width: 100%;
    margin-top: 12px;
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 24px;
    -unity-text-align: upper-center;
    white-space: normal;
    color: var(--hud-gold);
}

.run-info {
    max-width: 100%;
    margin-top: 6px;
    font-size: 19px;
    -unity-text-align: upper-center;
    white-space: normal;
    color: var(--mm-ink-soft);
}

.run-buttons {
    flex-direction: row;
    justify-content: center;
    margin-top: 12px;
}

.run-btn {
    min-width: 200px;
}
