.run {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.run-hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.run-bag {
    position: absolute;
    bottom: 28px;
    right: 32px;
    flex-direction: row;
    align-items: center;
    height: 60px;
    padding: 0 26px 0 16px;
    background-image: url("Skin/Synty/Warrior/SPR_HUD_FantasyWarrior_Box_Small_Parchment_01.png");
    -unity-background-image-tint-color: rgba(31, 43, 46, 0.9);
    -unity-slice-scale: 0.33;
}

.run-bag__icon {
    width: 40px;
    height: 40px;
    background-image: url("Skin/Synty/ICON_SM_Item_Crystal_02.png");
    -unity-background-scale-mode: scale-to-fit;
}

.run-bag__count {
    margin-left: 10px;
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 36px;
    color: rgb(228, 189, 63);
    padding: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.run-left {
    position: absolute;
    left: 0;
    right: 0;
    top: 132px;
    align-items: center;
}

.run-left__pill {
    flex-direction: row;
    align-items: center;
    height: 40px;
    padding: 0 18px;
    background-image: url("Skin/Synty/Warrior/SPR_HUD_FantasyWarrior_Box_Small_Parchment_01.png");
    -unity-background-image-tint-color: rgba(31, 27, 22, 0.82);
    -unity-slice-scale: 0.33;
}

.run-left__text {
    margin: 0 0 0 10px;
    padding: 0;
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 19px;
    color: rgb(255, 255, 255);
}

.run-pips {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.run-pip {
    width: 12px;
    height: 12px;
    margin: 0 3px;
    border-radius: 6px;
    border-width: 2px;
}

.run-pip--done {
    background-color: rgb(168, 124, 66);
    border-color: rgb(168, 124, 66);
}

.run-pip--current {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background-color: var(--hud-gold);
    border-color: var(--hud-gold);
}

.run-pip--upcoming {
    background-color: rgba(17, 14, 12, 0.7);
    border-color: rgb(99, 75, 49);
}

.run-pips--big .run-pip {
    width: 24px;
    height: 24px;
    margin: 0 6px;
    border-radius: 12px;
    border-width: 4px;
}

.run-pips--big .run-pip--current {
    width: 32px;
    height: 32px;
    border-radius: 16px;
}

.run-trial {
    position: absolute;
    left: 50%;
    top: 182px;
    translate: -50% 0;
    padding: 6px 20px;
    background-image: url("Skin/Synty/Warrior/SPR_HUD_FantasyWarrior_Box_Small_Parchment_01.png");
    -unity-background-image-tint-color: rgba(31, 43, 46, 0.88);
    -unity-slice-scale: 0.33;
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 20px;
    -unity-text-align: middle-center;
    color: rgb(250, 208, 136);
}

.run-loot {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.run-loot__gem {
    position: absolute;
    left: 50%;
    top: 45%;
    width: 44px;
    height: 44px;
    margin-left: -22px;
    margin-top: -22px;
    opacity: 0;
    background-image: url("Skin/Synty/ICON_SM_Item_Crystal_02.png");
    -unity-background-scale-mode: scale-to-fit;
}

.run-veil {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    opacity: 0;
    background-color: rgba(10, 7, 6, 0.94);
}

.run-veil__glyph {
    width: 168px;
    height: 168px;
    margin-bottom: 14px;
    -unity-background-scale-mode: scale-to-fit;
}

.run-veil__title {
    margin: 4px 0;
    padding: 0;
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 78px;
    letter-spacing: 3px;
    color: rgb(255, 255, 255);
    text-shadow: 0 4px 6px rgba(0, 0, 0, 0.75);
}

.run-veil .run-pips {
    margin-bottom: 16px;
}

.run-veil__left {
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 26px;
    color: var(--hud-gold);
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.7);
}

.run-rooms {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 14px;
}

.run-room {
    width: 72px;
    height: 72px;
    margin: 0 6px;
    align-items: center;
    justify-content: center;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Box_Rounded_Medium_01.png");
    -unity-background-image-tint-color: var(--hud-slot);
    -unity-slice-scale: 0.2;
}

.run-room--current {
    -unity-background-image-tint-color: var(--hud-slot-active);
    scale: 1.08 1.08;
}

.run-room--done {
    opacity: 0.35;
}

.run-room__runes {
    position: absolute;
    left: 6px;
    top: 6px;
    right: 6px;
    bottom: 6px;
    background-image: url("Skin/Synty/SPR_HUD_FantasyWarrior_Tracery_Diamond_01.png");
    -unity-background-image-tint-color: rgba(36, 32, 26, 0.6);
}

.run-room__frame {
    position: absolute;
    left: -5px;
    top: -1px;
    right: -5px;
    bottom: -9px;
    background-image: url("Skin/Synty/SPR_FantasyScreens_Frame_Rounded_02.png");
    -unity-background-image-tint-color: var(--hud-gold);
    -unity-slice-scale: 0.25;
    opacity: 0;
}

.run-room--current .run-room__frame {
    opacity: 1;
}

.run-room__glyph {
    width: 52px;
    height: 52px;
    -unity-background-scale-mode: scale-to-fit;
}

.run-glyph--foe {
    -unity-background-image-tint-color: var(--mm-foe);
}

.run-glyph--heal {
    -unity-background-image-tint-color: var(--mm-good);
}

.run-glyph--mineral {
    -unity-background-image-tint-color: var(--mm-teal);
}

.run-card-wrap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 24px;
    align-items: center;
}

.run-card {
    width: 620px;
    max-width: 90%;
    align-items: center;
}

.run-title {
    font-size: 34px;
}

.run-minerita {
    max-width: 100%;
    margin-top: 12px;
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 24px;
    -unity-text-align: upper-center;
    white-space: normal;
    color: var(--hud-gold);
}

.run-info {
    max-width: 100%;
    margin-top: 6px;
    font-size: 19px;
    -unity-text-align: upper-center;
    white-space: normal;
    color: var(--mm-ink-soft);
}

.run-buttons {
    flex-direction: row;
    justify-content: center;
    margin-top: 12px;
}

.run-btn {
    min-width: 200px;
}

.run-veil__vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("Skin/Synty/SPR_FantasyMenus_Background_Vignette_01.png");
    -unity-background-image-tint-color: rgba(0, 0, 0, 0.85);
    -unity-background-scale-mode: stretch-to-fill;
}

.run-veil__line {
    width: 760px;
    height: 24px;
    flex-direction: row;
}

.run-veil__half {
    flex-grow: 1;
    -unity-background-image-tint-color: rgb(255, 204, 95);
    -unity-slice-scale: 0.3;
}

.run-veil__half--l {
    background-image: url("Skin/Synty/Warrior/SPR_HUD_FantasyWarrior_Line_03_Right.png");
}

.run-veil__half--r {
    background-image: url("Skin/Synty/Warrior/SPR_HUD_FantasyWarrior_Line_03_Left.png");
}

.run-veil__line--bottom {
    scale: 1 -1;
    margin-bottom: 18px;
}

.run-team {
    flex-direction: row;
    justify-content: center;
    margin-top: 14px;
}

.run-member {
    width: 150px;
    margin: 0 8px;
    align-items: center;
}

.run-member__portrait {
    width: 96px;
    height: 96px;
    background-image: url("Skin/Synty/Warrior/SPR_HUD_FantasyWarrior_Gradient_Vertical_Smooth_01.png");
    -unity-background-image-tint-color: rgba(49, 99, 219, 0.9);
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgb(0, 19, 53);
}

.run-member__photo {
    position: absolute;
    left: 4px;
    top: 4px;
    right: 4px;
    bottom: 4px;
}

.run-member__frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("Skin/Synty/Warrior/SPR_FantasyWarrior_Frame_Box_Medium_01_Variant_01.png");
    -unity-slice-scale: 0.28;
}

.run-member__name {
    max-width: 150px;
    margin: 6px 0 2px 0;
    padding: 0;
    -unity-font-definition: url("Skin/Fonts/LTMuseum-Bold.ttf");
    font-size: 19px;
    color: rgb(255, 255, 255);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.run-member__bar {
    width: 120px;
    height: 12px;
    background-image: url("Skin/Synty/Warrior/SPR_FantasyWarrior_Bar_Horizontal_03_Mask.png");
    -unity-background-image-tint-color: rgba(25, 26, 29, 0.9);
    -unity-slice-scale: 0.12;
    overflow: hidden;
}

.run-member__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background-image: url("Skin/Synty/Warrior/SPR_FantasyWarrior_Bar_Horizontal_05.png");
    -unity-background-image-tint-color: rgb(110, 196, 96);
    -unity-slice-scale: 0.12;
}

.run-member--hurt .run-member__fill {
    -unity-background-image-tint-color: rgb(236, 168, 64);
}

.run-member__pct {
    margin: 2px 0 0 0;
    padding: 0;
    -unity-font-definition: url("Skin/Fonts/Grenze-SemiBold.ttf");
    font-size: 16px;
    color: var(--mm-ink-soft);
}
